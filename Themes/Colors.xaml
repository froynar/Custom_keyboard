<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="SidebarBgColor">#111827</Color>
    <Color x:Key="SidebarBgAltColor">#1F2937</Color>
    <Color x:Key="SidebarTextColor">#F8FAFC</Color>
    <Color x:Key="SidebarMutedColor">#9CA3AF</Color>
    <Color x:Key="AccentColor">#0F766E</Color>
    <Color x:Key="AccentDarkColor">#115E59</Color>
    <Color x:Key="AccentSoftColor">#CCFBF1</Color>
    <Color x:Key="BodyBgColor">#EEF2F7</Color>
    <Color x:Key="CardBgColor">#FFFFFF</Color>
    <Color x:Key="CardBgAltColor">#F8FAFC</Color>
    <Color x:Key="BorderColor">#D7DEE8</Color>
    <Color x:Key="TextPrimaryColor">#111827</Color>
    <Color x:Key="TextMutedColor">#64748B</Color>
    <Color x:Key="SuccessColor">#16A34A</Color>
    <Color x:Key="InfoColor">#2563EB</Color>
    <Color x:Key="WarningColor">#D97706</Color>
    <Color x:Key="DangerColor">#DC2626</Color>
    <Color x:Key="DefaultBadgeColor">#94A3B8</Color>
    <Color x:Key="GoldColor">#B45309</Color>
    <Color x:Key="RoseColor">#BE123C</Color>
    <Color x:Key="InkColor">#0B1120</Color>

    <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBgColor}"/>
    <SolidColorBrush x:Key="SidebarBgAltBrush" Color="{StaticResource SidebarBgAltColor}"/>
    <SolidColorBrush x:Key="SidebarTextBrush" Color="{StaticResource SidebarTextColor}"/>
    <SolidColorBrush x:Key="SidebarMutedBrush" Color="{StaticResource SidebarMutedColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="BodyBgBrush" Color="{StaticResource BodyBgColor}"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}"/>
    <SolidColorBrush x:Key="CardBgAltBrush" Color="{StaticResource CardBgAltColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DefaultBadgeBrush" Color="{StaticResource DefaultBadgeColor}"/>
    <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}"/>
    <SolidColorBrush x:Key="RoseBrush" Color="{StaticResource RoseColor}"/>
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}"/>

    <LinearGradientBrush x:Key="AppBackdropBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F8FAFC" Offset="0"/>
        <GradientStop Color="#E2E8F0" Offset="0.45"/>
        <GradientStop Color="#F1F5F9" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0B1120" Offset="0"/>
        <GradientStop Color="#111827" Offset="0.55"/>
        <GradientStop Color="#164E63" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroPanelBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0B1120" Offset="0"/>
        <GradientStop Color="#12333B" Offset="0.55"/>
        <GradientStop Color="#0F766E" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>
