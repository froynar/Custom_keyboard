// Simple account hierarchy:
// User is Buyer, Seller, or Admin.
// Seller is a Buyer with an additional seller profile.

Enum UserRole {
  Buyer
  Seller
  Admin
}

Table users {
  id int [pk, increment]
  role UserRole [not null, default: 'Buyer']
  username varchar(100) [unique, not null]
  email varchar(255) [unique, not null]
  phone varchar(30) [unique, not null]
  password_hash varchar(255) [not null]
  is_active boolean [not null, default: true]

  Note: 'Base account. Seller inherits all Buyer capabilities in application logic; Admin is a separate system role.'
}

Table seller_profiles {
  user_id int [pk, ref: - users.id]
  shop_name varchar(255) [not null]
  shop_address varchar(500) [not null]
  is_verified boolean [not null, default: false]
  verified_at datetime

  Note: 'Optional one-to-one extension used only when users.role = Seller. Approval changes Buyer to Seller and creates this row. Contact phone is reused from users.phone.'
}
