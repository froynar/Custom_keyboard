<UserControl x:Class="Custom_keyboard.Views.UserMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Custom_keyboard.Localization"
             MinWidth="0">
    <UserControl.Resources>
        <Style x:Key="UserMenuToggle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#EEF2F6"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#E3F6F1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UserMenuAction" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F5F7FA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.72"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UserMenuToggleAction" TargetType="{x:Type ToggleButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F5F7FA"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#E3F6F1"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ToggleButton x:Name="UserMenuButton"
                      AutomationProperties.AutomationId="UserMenuButton"
                      Style="{StaticResource UserMenuToggle}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="28" Height="28" CornerRadius="14"
                        Background="{StaticResource BorderBrush}" Margin="0,0,8,0">
                    <TextBlock Text="&#xE77B;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentUser.Username}"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding CurrentUser.Role}"
                               FontSize="10"
                               Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
                <TextBlock Text="&#xE70D;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="10"
                           Foreground="{StaticResource TextMutedBrush}"
                           Margin="7,1,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </ToggleButton>

        <Popup IsOpen="{Binding IsChecked, ElementName=UserMenuButton, Mode=TwoWay}"
               PlacementTarget="{Binding ElementName=UserMenuButton}"
               Placement="Bottom"
               HorizontalOffset="-220"
               VerticalOffset="8"
               StaysOpen="False"
               AllowsTransparency="True"
               DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <Border Width="260"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16"
                                      ShadowDepth="3"
                                      Opacity="0.14"
                                      Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <DockPanel Margin="2,2,2,10">
                        <Border DockPanel.Dock="Left"
                                Width="40" Height="40" CornerRadius="20"
                                Background="{StaticResource AccentBrush}"
                                Margin="0,0,10,0">
                            <TextBlock Text="&#xE77B;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="White"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentUser.Username}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding CurrentUser.Email}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock FontSize="11"
                                       Foreground="{StaticResource AccentBrush}">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} {1}">
                                        <Binding Path="[UserMenu_RoleLabel]" Source="{x:Static loc:Loc.Instance}"/>
                                        <Binding Path="CurrentUser.Role"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,6"/>

                    <ToggleButton x:Name="ProfileDetailsToggle"
                                  AutomationProperties.AutomationId="UserMenuProfileButton"
                                  Style="{StaticResource UserMenuToggleAction}"
                                  ToolTip="{loc:Tr UserMenu_ProfileTooltip}">
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="&#xE13D;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                            <TextBlock DockPanel.Dock="Left" Text="{loc:Tr UserMenu_ProfileSettings}"/>
                            <TextBlock DockPanel.Dock="Right"
                                       Text="&#xE70D;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="10"
                                       Margin="8,1,0,0"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </DockPanel>
                    </ToggleButton>

                    <Border AutomationProperties.AutomationId="UserMenuProfileDetails"
                            Visibility="{Binding IsChecked, ElementName=ProfileDetailsToggle, Converter={StaticResource BoolToVis}}"
                            Background="#F8FBFD"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10"
                            Margin="0,4,0,6">
                        <StackPanel>
                            <TextBlock AutomationProperties.AutomationId="UserMenuProfileDetails"
                                       Text="{loc:Tr UserMenu_AccountProfile}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Tr Common_Username}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding CurrentUser.Username}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Tr Common_Email}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding CurrentUser.Email}"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Tr Common_Phone}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding CurrentUser.Phone}"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Tr Common_Role}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding CurrentUser.Role}"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Tr Common_Status}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LocalizedBoolLabel}" ConverterParameter="Common_Active|Common_Inactive">
                                            <Binding Path="CurrentUser.IsActive"/>
                                            <Binding Path="Language" Source="{x:Static loc:Loc.Instance}"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>

                            <TextBlock Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11"
                                       Margin="0,3,0,0">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} {1}">
                                        <Binding Path="[UserMenu_UserIdLabel]" Source="{x:Static loc:Loc.Instance}"/>
                                        <Binding Path="CurrentUser.UserId"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Text="{loc:Tr UserMenu_ViewOnlyNote}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource UserMenuAction}"
                            IsEnabled="False"
                            ToolTip="{loc:Tr UserMenu_AccountSettingsTooltip}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                            <TextBlock Text="{loc:Tr UserMenu_AccountSettings}"/>
                        </DockPanel>
                    </Button>

                    <!-- Preferences: language switcher (expands like Profile settings) -->
                    <ToggleButton x:Name="PreferencesToggle"
                                  AutomationProperties.AutomationId="UserMenuPreferencesButton"
                                  Style="{StaticResource UserMenuToggleAction}"
                                  ToolTip="{loc:Tr UserMenu_PreferencesTooltip}">
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                            <TextBlock DockPanel.Dock="Left" Text="{loc:Tr UserMenu_Preferences}"/>
                            <TextBlock DockPanel.Dock="Right"
                                       Text="&#xE70D;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="10"
                                       Margin="8,1,0,0"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </DockPanel>
                    </ToggleButton>

                    <Border AutomationProperties.AutomationId="UserMenuLanguagePanel"
                            Visibility="{Binding IsChecked, ElementName=PreferencesToggle, Converter={StaticResource BoolToVis}}"
                            Background="#F8FBFD"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10"
                            Margin="0,4,0,6">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr UserMenu_Language}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,8"/>
                            <RadioButton Content="Tiếng Việt"
                                         GroupName="appLanguage"
                                         AutomationProperties.AutomationId="LanguageVietnameseOption"
                                         Margin="0,2"
                                         IsChecked="{Binding Language, Source={x:Static loc:Loc.Instance}, Converter={StaticResource EnumToBool}, ConverterParameter=Vietnamese, Mode=TwoWay}"/>
                            <RadioButton Content="English"
                                         GroupName="appLanguage"
                                         AutomationProperties.AutomationId="LanguageEnglishOption"
                                         Margin="0,2"
                                         IsChecked="{Binding Language, Source={x:Static loc:Loc.Instance}, Converter={StaticResource EnumToBool}, ConverterParameter=English, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,6"/>

                    <Button AutomationProperties.AutomationId="UserMenuLogoutButton"
                            Style="{StaticResource UserMenuAction}"
                            Command="{Binding LogoutCommand}"
                            Foreground="{StaticResource DangerBrush}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE8AC;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                            <TextBlock Text="{loc:Tr UserMenu_Logout}"/>
                        </DockPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
