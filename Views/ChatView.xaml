<UserControl x:Class="Custom_keyboard.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Conversation list + start panel -->
        <Border Background="White" BorderBrush="#DDE2E8" BorderThickness="1" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Hoi thoai" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>

                <StackPanel Grid.Row="1" Visibility="{Binding StartConversationVisibility}" Margin="0,0,0,10">
                    <TextBlock Text="{Binding CounterpartLabel}" Foreground="#687381" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Counterparts}"
                              SelectedItem="{Binding SelectedCounterpart}"
                              DisplayMemberPath="ShopName"/>
                    <Button Content="Mo hoi thoai voi seller"
                            Command="{Binding StartConversationCommand}"
                            Margin="0,8,0,0" Padding="10,6"
                            Background="#2F6FED" Foreground="White" BorderThickness="0"/>
                </StackPanel>

                <ListBox Grid.Row="2"
                         ItemsSource="{Binding Conversations}"
                         SelectedItem="{Binding SelectedConversation}"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Subtitle}" Foreground="#9098A1" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Row="3" Content="Refresh hoi thoai"
                        Command="{Binding RefreshConversationsCommand}"
                        Margin="0,10,0,0" Padding="10,6"
                        Background="#EEF2F6" BorderBrush="#DDE2E8"/>
            </Grid>
        </Border>

        <!-- Messages + composer -->
        <Border Grid.Column="2" Background="White" BorderBrush="#DDE2E8" BorderThickness="1" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,4" Padding="10,6" CornerRadius="6"
                                        MaxWidth="420"
                                        HorizontalAlignment="{Binding Alignment}"
                                        Background="#EEF2F6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SenderLabel}" FontSize="11" Foreground="#687381"/>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding SentAt, StringFormat=yyyy-MM-dd HH:mm}"
                                                   FontSize="10" Foreground="#9098A1" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <DockPanel Grid.Row="1" Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" Content="Gui"
                            Command="{Binding SendMessageCommand}"
                            Margin="8,0,0,0" Padding="16,8"
                            Background="#2F6FED" Foreground="White" BorderThickness="0"/>
                    <TextBox Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8" VerticalContentAlignment="Center"/>
                </DockPanel>

                <TextBlock Grid.Row="2" Text="{Binding StatusMessage}"
                           Foreground="#687381" FontSize="12" Margin="0,8,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
