<UserControl x:Class="Custom_keyboard.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:Custom_keyboard.Behaviors">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#EEF2F6" Offset="0"/>
                <GradientStop Color="#F7F7F7" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Border Width="420"
                Padding="30"
                Style="{StaticResource DashboardCard}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Border Width="40" Height="40" CornerRadius="8"
                            Background="{StaticResource AccentBrush}" Margin="0,0,12,0">
                        <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets"
                                   Foreground="White" FontSize="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CK Builder" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Custom Keyboard" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="Dang nhap"
                           FontSize="{StaticResource FontSizeHero}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Dang nhap de tiep tuc"
                           Margin="0,4,0,24"
                           FontSize="14"
                           Foreground="{StaticResource TextMutedBrush}"/>

                <TextBlock Text="Email hoac username"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBox Text="{Binding EmailOrUsername, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,6,0,14"/>

                <TextBlock Text="Mat khau"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <PasswordBox behaviors:PasswordBoxBinding.Attach="True"
                             behaviors:PasswordBoxBinding.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,6,0,14"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap"
                           MinHeight="20"/>
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource SuccessBrush}"
                           TextWrapping="Wrap"
                           MinHeight="20"/>

                <Button Content="Dang nhap"
                        Command="{Binding LoginCommand}"
                        Margin="0,8,0,10"
                        Style="{StaticResource PrimaryButton}"/>

                <Button Content="Tao tai khoan buyer"
                        Command="{Binding ShowRegisterCommand}"
                        Style="{StaticResource SecondaryButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
