<UserControl x:Class="Custom_keyboard.Views.AdminDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Custom_keyboard.Views"
             Loaded="OnLoaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Dang xuat" Command="{Binding LogoutCommand}"
                    Padding="14,8" Background="#EEF2F6" BorderBrush="#DDE2E8"/>
            <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshAllCommand}"
                    Margin="0,0,8,0" Padding="14,8" Background="#EEF2F6" BorderBrush="#DDE2E8"/>
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Foreground="#20242B"/>
                <TextBlock Text="{Binding Subtitle}" Margin="0,4,0,0" Foreground="#687381"/>
            </StackPanel>
        </DockPanel>

        <!-- Summary -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Border Background="White" BorderBrush="#DDE2E8" BorderThickness="1" Padding="14,8" Margin="0,0,10,0">
                <StackPanel><TextBlock Text="Users" Foreground="#687381" FontSize="12"/><TextBlock Text="{Binding Summary.TotalUsers}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#DDE2E8" BorderThickness="1" Padding="14,8" Margin="0,0,10,0">
                <StackPanel><TextBlock Text="Sellers" Foreground="#687381" FontSize="12"/><TextBlock Text="{Binding Summary.TotalSellers}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#DDE2E8" BorderThickness="1" Padding="14,8" Margin="0,0,10,0">
                <StackPanel><TextBlock Text="Linh kien" Foreground="#687381" FontSize="12"/><TextBlock Text="{Binding Summary.TotalComponents}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#DDE2E8" BorderThickness="1" Padding="14,8">
                <StackPanel><TextBlock Text="Requests" Foreground="#687381" FontSize="12"/><TextBlock Text="{Binding Summary.TotalRequests}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
            </Border>
        </StackPanel>

        <TabControl Grid.Row="2">
            <!-- Users -->
            <TabItem Header="User">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>
                    <ListBox ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" BorderBrush="#DDE2E8" BorderThickness="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding Username}" FontWeight="SemiBold"/>
                                    <TextBlock FontSize="12" Foreground="#687381">
                                        <Run Text="{Binding Email}"/><Run Text=" | "/><Run Text="{Binding Role}"/>
                                        <Run Text=" | active="/><Run Text="{Binding IsActive}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Role" Foreground="#687381" FontSize="12"/>
                        <ComboBox ItemsSource="{Binding AvailableRoles}" SelectedItem="{Binding SelectedUserRole}" Margin="0,2,0,8"/>
                        <Button Content="Doi role" Command="{Binding ChangeUserRoleCommand}" Margin="0,0,0,8" Padding="10,6"
                                Background="#2F6FED" Foreground="White" BorderThickness="0"/>
                        <Button Content="Ban user" Command="{Binding BanUserCommand}" Margin="0,0,0,8" Padding="10,6"
                                Background="#E5484D" Foreground="White" BorderThickness="0"/>
                        <Button Content="Mo ban" Command="{Binding UnbanUserCommand}" Padding="10,6"
                                Background="#1F9D5B" Foreground="White" BorderThickness="0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Sellers -->
            <TabItem Header="Seller">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <ListBox ItemsSource="{Binding SellerProfiles}" SelectedItem="{Binding SelectedSellerProfile}" BorderBrush="#DDE2E8" BorderThickness="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding Username}" FontWeight="SemiBold"/>
                                    <TextBlock FontSize="12" Foreground="#687381">
                                        <Run Text="{Binding ShopName}"/><Run Text=" | verified="/><Run Text="{Binding IsVerified}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Shop name" Foreground="#687381" FontSize="12"/>
                        <TextBox Text="{Binding SellerShopName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" Padding="6"/>
                        <TextBlock Text="Phone" Foreground="#687381" FontSize="12"/>
                        <TextBox Text="{Binding SellerPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" Padding="6"/>
                        <TextBlock Text="Address" Foreground="#687381" FontSize="12"/>
                        <TextBox Text="{Binding SellerAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" Padding="6" TextWrapping="Wrap" MinHeight="44"/>
                        <Button Content="Luu profile" Command="{Binding SaveSellerProfileCommand}" Margin="0,0,0,8" Padding="10,6"
                                Background="#2F6FED" Foreground="White" BorderThickness="0"/>
                        <Button Content="Verify" Command="{Binding VerifySellerCommand}" Margin="0,0,0,8" Padding="10,6"
                                Background="#1F9D5B" Foreground="White" BorderThickness="0"/>
                        <Button Content="Unverify" Command="{Binding UnverifySellerCommand}" Padding="10,6"
                                Background="#EEF2F6" BorderBrush="#DDE2E8"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Brand & Layout -->
            <TabItem Header="Brand &amp; Layout">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border BorderBrush="#DDE2E8" BorderThickness="1" Background="White" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Brands" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ListBox ItemsSource="{Binding Brands}" SelectedItem="{Binding SelectedBrand}" Height="160" BorderThickness="0"
                                     DisplayMemberPath="BrandName"/>
                            <TextBlock Text="Ten brand" Foreground="#687381" FontSize="12" Margin="0,8,0,0"/>
                            <TextBox Text="{Binding BrandEditor.BrandName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" Padding="6"/>
                            <TextBlock Text="Quoc gia" Foreground="#687381" FontSize="12"/>
                            <TextBox Text="{Binding BrandEditor.Country, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" Padding="6"/>
                            <WrapPanel>
                                <Button Content="Moi" Command="{Binding NewBrandCommand}" Margin="0,0,8,0" Padding="10,6" Background="#EEF2F6" BorderBrush="#DDE2E8"/>
                                <Button Content="Luu brand" Command="{Binding SaveBrandCommand}" Padding="10,6" Background="#2F6FED" Foreground="White" BorderThickness="0"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" BorderBrush="#DDE2E8" BorderThickness="1" Background="White" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Layouts" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ListBox ItemsSource="{Binding Layouts}" SelectedItem="{Binding SelectedLayout}" Height="160" BorderThickness="0"
                                     DisplayMemberPath="LayoutName"/>
                            <TextBlock Text="Layout id" Foreground="#687381" FontSize="12" Margin="0,8,0,0"/>
                            <TextBox Text="{Binding LayoutEditor.LayoutId, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" Padding="6"/>
                            <TextBlock Text="Ten" Foreground="#687381" FontSize="12"/>
                            <TextBox Text="{Binding LayoutEditor.LayoutName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" Padding="6"/>
                            <TextBlock Text="Form factor" Foreground="#687381" FontSize="12"/>
                            <TextBox Text="{Binding LayoutEditor.FormFactor, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" Padding="6"/>
                            <TextBlock Text="Key count" Foreground="#687381" FontSize="12"/>
                            <TextBox Text="{Binding LayoutEditor.KeyCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" Padding="6"/>
                            <WrapPanel>
                                <Button Content="Moi" Command="{Binding NewLayoutCommand}" Margin="0,0,8,0" Padding="10,6" Background="#EEF2F6" BorderBrush="#DDE2E8"/>
                                <Button Content="Luu layout" Command="{Binding SaveLayoutCommand}" Padding="10,6" Background="#2F6FED" Foreground="White" BorderThickness="0"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Components -->
            <TabItem Header="Linh kien">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>

                    <Border BorderBrush="#DDE2E8" BorderThickness="1" Background="White" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,8">
                                <ComboBox DockPanel.Dock="Right" Width="150" ItemsSource="{Binding ComponentTypes}" SelectedItem="{Binding SelectedComponentType}"/>
                                <TextBlock Text="Loai" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Components}" SelectedItem="{Binding SelectedComponent}" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock FontSize="12" Foreground="#687381">
                                                <Run Text="{Binding ComponentId}"/><Run Text=" | "/>
                                                <Run Text="{Binding PriceUsd, StringFormat={}{0:F2} USD}"/>
                                                <Run Text=" | available="/><Run Text="{Binding IsAvailable}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                                <Button Content="An" Command="{Binding HideComponentCommand}" Margin="0,0,8,0" Padding="10,6" Background="#EEF2F6" BorderBrush="#DDE2E8"/>
                                <Button Content="Khoi phuc" Command="{Binding RestoreComponentCommand}" Padding="10,6" Background="#EEF2F6" BorderBrush="#DDE2E8"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" BorderBrush="#DDE2E8" BorderThickness="1" Background="White" Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Editor linh kien" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Text="Component id" Foreground="#687381" FontSize="12"/>
                                <TextBox Text="{Binding ComponentEditor.ComponentId, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" Padding="6"/>
                                <TextBlock Text="Ten" Foreground="#687381" FontSize="12"/>
                                <TextBox Text="{Binding ComponentEditor.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" Padding="6"/>
                                <TextBlock Text="Gia (USD)" Foreground="#687381" FontSize="12"/>
                                <TextBox Text="{Binding ComponentEditor.PriceUsd, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" Padding="6"/>
                                <CheckBox Content="Available" IsChecked="{Binding ComponentEditor.IsAvailable}" Margin="0,0,0,6"/>

                                <StackPanel Visibility="{Binding BrandFieldVisibility}">
                                    <TextBlock Text="Brand" Foreground="#687381" FontSize="12"/>
                                    <ComboBox ItemsSource="{Binding Brands}" SelectedValue="{Binding ComponentEditor.BrandId}"
                                              SelectedValuePath="BrandId" DisplayMemberPath="BrandName" Margin="0,2,0,6"/>
                                </StackPanel>

                                <!-- Kit -->
                                <StackPanel Visibility="{Binding KitFieldsVisibility}">
                                    <TextBlock Text="Layout" Foreground="#687381" FontSize="12"/>
                                    <ComboBox ItemsSource="{Binding Layouts}" SelectedValue="{Binding ComponentEditor.LayoutId}"
                                              SelectedValuePath="LayoutId" DisplayMemberPath="LayoutName" Margin="0,2,0,6"/>
                                    <TextBlock Text="PCB technology" Foreground="#687381" FontSize="12"/>
                                    <TextBox Text="{Binding ComponentEditor.PcbTechnology, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" Padding="6"/>
                                    <TextBlock Text="Switch mount" Foreground="#687381" FontSize="12"/>
                                    <TextBox Text="{Binding ComponentEditor.SwitchMount, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" Padding="6"/>
                                    <TextBlock Text="Required switch quantity" Foreground="#687381" FontSize="12"/>
                                    <TextBox Text="{Binding ComponentEditor.RequiredSwitchQuantity, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" Padding="6"/>
                                    <TextBlock Text="Included parts" Foreground="#687381" FontSize="12"/>
                                    <TextBox Text="{Binding ComponentEditor.IncludedParts, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" Padding="6" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Switch -->
                                <StackPanel Visibility="{Binding SwitchFieldsVisibility}">
                                    <TextBlock Text="Switch technology" Foreground="#687381" FontSize="12"/>
                                    <TextBox Text="{Binding ComponentEditor.SwitchTechnology, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" Padding="6"/>
                                    <TextBlock Text="Mount type" Foreground="#687381" FontSize="12"/>
                                    <TextBox Text="{Binding ComponentEditor.MountType, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" Padding="6"/>
                                    <TextBlock Text="Switch type" Foreground="#687381" FontSize="12"/>
                                    <TextBox Text="{Binding ComponentEditor.SwitchType, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" Padding="6"/>
                                    <TextBlock Text="Actuation force (g)" Foreground="#687381" FontSize="12"/>
                                    <TextBox Text="{Binding ComponentEditor.ActuationForceG, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Margin="0,2,0,6" Padding="6"/>
                                </StackPanel>

                                <!-- Keycap -->
                                <StackPanel Visibility="{Binding KeycapFieldsVisibility}">
                                    <TextBlock Text="Supported form factor" Foreground="#687381" FontSize="12"/>
                                    <TextBox Text="{Binding ComponentEditor.SupportedFormFactor, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" Padding="6"/>
                                    <TextBlock Text="Profile" Foreground="#687381" FontSize="12"/>
                                    <TextBox Text="{Binding ComponentEditor.Profile, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" Padding="6"/>
                                    <TextBlock Text="Material" Foreground="#687381" FontSize="12"/>
                                    <TextBox Text="{Binding ComponentEditor.Material, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" Padding="6"/>
                                </StackPanel>

                                <!-- Stabilizer -->
                                <StackPanel Visibility="{Binding StabilizerFieldsVisibility}">
                                    <TextBlock Text="Supported layouts" Foreground="#687381" FontSize="12"/>
                                    <TextBox Text="{Binding ComponentEditor.SupportedLayouts, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" Padding="6"/>
                                </StackPanel>

                                <!-- Accessory -->
                                <StackPanel Visibility="{Binding AccessoryFieldsVisibility}">
                                    <TextBlock Text="Accessory type" Foreground="#687381" FontSize="12"/>
                                    <TextBox Text="{Binding ComponentEditor.AccessoryType, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" Padding="6"/>
                                    <TextBlock Text="Target component" Foreground="#687381" FontSize="12"/>
                                    <TextBox Text="{Binding ComponentEditor.TargetComponent, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" Padding="6"/>
                                </StackPanel>

                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Moi" Command="{Binding NewComponentCommand}" Margin="0,0,8,0" Padding="10,6" Background="#EEF2F6" BorderBrush="#DDE2E8"/>
                                    <Button Content="Luu linh kien" Command="{Binding SaveComponentCommand}" Padding="10,6" Background="#2F6FED" Foreground="White" BorderThickness="0"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Audit -->
            <TabItem Header="Audit log">
                <Grid Margin="0,12,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Content="Refresh audit"
                                Command="{Binding RefreshAuditCommand}" Margin="0,0,0,8" Padding="10,6"
                                Background="#EEF2F6" BorderBrush="#DDE2E8"/>
                        <ListBox ItemsSource="{Binding AuditLogs}" BorderBrush="#DDE2E8" BorderThickness="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock FontWeight="SemiBold">
                                            <Run Text="{Binding Action}"/><Run Text=" - "/><Run Text="{Binding TableName}"/>
                                            <Run Text=" #"/><Run Text="{Binding RecordId}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding ChangedAt, StringFormat=yyyy-MM-dd HH:mm}" FontSize="12" Foreground="#687381"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- Chat -->
            <TabItem Header="Chat">
                <Grid Margin="0,12,0,0">
                    <views:ChatView DataContext="{Binding Chat}"/>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Margin="0,12,0,0" Foreground="#687381"/>
    </Grid>
</UserControl>
