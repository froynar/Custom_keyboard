<UserControl x:Class="Custom_keyboard.Views.AdminDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Custom_keyboard.Views"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Loaded="OnLoaded">
    <Grid Background="{StaticResource BodyBgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource SidebarBgBrush}" Padding="18">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                        <Border Width="30" Height="30" CornerRadius="6"
                                Background="{StaticResource AccentBrush}" Margin="0,0,10,0">
                            <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets"
                                       Foreground="White" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="CK Builder"
                                   Foreground="{StaticResource SidebarTextBrush}"
                                   FontSize="20" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Admin workspace"
                               Foreground="#AFC1D0"
                               FontSize="12"
                               Margin="0,0,0,24"/>

                    <RadioButton x:Name="NavOverview" Content="Tong quan" GroupName="adminNav"
                                 Style="{StaticResource SidebarNav}" IsChecked="True"/>
                    <RadioButton x:Name="NavUser" Content="Nguoi dung" GroupName="adminNav"
                                 Style="{StaticResource SidebarNav}"/>
                    <RadioButton x:Name="NavSeller" Content="Seller" GroupName="adminNav"
                                 Style="{StaticResource SidebarNav}"/>
                    <RadioButton x:Name="NavBrand" Content="Brand &amp; Layout" GroupName="adminNav"
                                 Style="{StaticResource SidebarNav}"/>
                    <RadioButton x:Name="NavComponent" Content="Linh kien" GroupName="adminNav"
                                 Style="{StaticResource SidebarNav}"/>
                    <RadioButton x:Name="NavAudit" Content="Audit log" GroupName="adminNav"
                                 Style="{StaticResource SidebarNav}"/>
                    <RadioButton x:Name="NavChat" Content="Chat" GroupName="adminNav"
                                 Style="{StaticResource SidebarNav}"/>
                </StackPanel>

                <Border DockPanel.Dock="Bottom"
                        Background="{StaticResource SidebarBgAltBrush}"
                        CornerRadius="4"
                        Padding="12">
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentUser.Username}"
                                   Foreground="{StaticResource SidebarTextBrush}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Admin" Foreground="{StaticResource AccentBrush}" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Topbar -->
            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Content="Dang xuat" Command="{Binding LogoutCommand}"
                        Style="{StaticResource SecondaryButton}"/>
                <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshAllCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding Subtitle}" Margin="0,4,0,0" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
            </DockPanel>

            <!-- KPI summary (always visible) -->
            <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,0,0,14">
                <Border Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <TextBlock Text="Users" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding Summary.TotalUsers}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <TextBlock Text="Sellers" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding Summary.TotalSellers}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <TextBlock Text="Linh kien" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding Summary.TotalComponents}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCard}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Requests" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding Summary.TotalRequests}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="2">
                <!-- ============ Tong quan (analytics) ============ -->
                <ScrollViewer Visibility="{Binding IsChecked, ElementName=NavOverview, Converter={StaticResource BoolToVis}}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Revenue KPI + period -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource KpiCard}">
                                <StackPanel>
                                    <TextBlock Text="Doanh thu toan san (USD)" Style="{StaticResource MutedText}"/>
                                    <TextBlock Text="{Binding TotalRevenue, StringFormat=N2}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource KpiCard}">
                                <StackPanel>
                                    <TextBlock Text="Don hoan thanh" Style="{StaticResource MutedText}"/>
                                    <TextBlock Text="{Binding CompletedOrders}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <ComboBox Grid.Column="3" Width="130" VerticalAlignment="Center"
                                      ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}"/>
                        </Grid>

                        <!-- Revenue line + status donut -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="360"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource DashboardCard}">
                                <StackPanel>
                                    <TextBlock Text="Doanh thu theo thoi gian" Style="{StaticResource SectionTitle}"/>
                                    <lvc:CartesianChart Height="280"
                                                        Series="{Binding RevenueSeries}"
                                                        XAxes="{Binding RevenueXAxes}"
                                                        YAxes="{Binding RevenueYAxes}"
                                                        TooltipPosition="Top"
                                                        ZoomMode="None"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource DashboardCard}">
                                <StackPanel>
                                    <TextBlock Text="Don theo trang thai" Style="{StaticResource SectionTitle}"/>
                                    <lvc:PieChart Height="280"
                                                  Series="{Binding StatusSeries}"
                                                  LegendPosition="Bottom"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Top sellers -->
                        <Border Style="{StaticResource DashboardCard}">
                            <StackPanel>
                                <TextBlock Text="Top seller theo doanh thu" Style="{StaticResource SectionTitle}"/>
                                <lvc:CartesianChart Height="260"
                                                    Series="{Binding TopSellersSeries}"
                                                    XAxes="{Binding TopSellersXAxes}"
                                                    TooltipPosition="Top"
                                                    ZoomMode="None"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Users ============ -->
                <Grid Visibility="{Binding IsChecked, ElementName=NavUser, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource DashboardCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Nguoi dung" Style="{StaticResource SectionTitle}"/>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" AlternationCount="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="USERNAME" Binding="{Binding Username}" Width="*"/>
                                    <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="*"/>
                                    <DataGridTextColumn Header="ROLE" Binding="{Binding Role}" Width="90"/>
                                    <DataGridTemplateColumn Header="TRANG THAI" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource BadgeChrome}" Background="{Binding IsActive, Converter={StaticResource BoolToBadgeBrush}}">
                                                    <TextBlock Style="{StaticResource StatusBadgeText}"
                                                               Text="{Binding IsActive, Converter={StaticResource BoolToLabel}, ConverterParameter='Active|Banned'}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource DashboardCard}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Thao tac" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Role" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding AvailableRoles}" SelectedItem="{Binding SelectedUserRole}" Margin="0,0,0,12"/>
                            <Button Content="Doi role" Command="{Binding ChangeUserRoleCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                            <Button Content="Ban user" Command="{Binding BanUserCommand}" Style="{StaticResource DangerButton}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                            <Button Content="Mo ban" Command="{Binding UnbanUserCommand}" Style="{StaticResource SuccessButton}" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============ Sellers ============ -->
                <Grid Visibility="{Binding IsChecked, ElementName=NavSeller, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource DashboardCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Seller" Style="{StaticResource SectionTitle}"/>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding SellerProfiles}" SelectedItem="{Binding SelectedSellerProfile}" AlternationCount="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="USERNAME" Binding="{Binding Username}" Width="*"/>
                                    <DataGridTextColumn Header="SHOP" Binding="{Binding ShopName}" Width="*"/>
                                    <DataGridTemplateColumn Header="VERIFY" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource BadgeChrome}" Background="{Binding IsVerified, Converter={StaticResource BoolToBadgeBrush}}">
                                                    <TextBlock Style="{StaticResource StatusBadgeText}"
                                                               Text="{Binding IsVerified, Converter={StaticResource BoolToLabel}, ConverterParameter='Verified|Chua verify'}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource DashboardCard}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Profile seller" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Shop name" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding SellerShopName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                            <TextBlock Text="Phone" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding SellerPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                            <TextBlock Text="Address" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding SellerAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="44"/>
                            <Button Content="Luu profile" Command="{Binding SaveSellerProfileCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                            <Button Content="Verify" Command="{Binding VerifySellerCommand}" Style="{StaticResource SuccessButton}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                            <Button Content="Unverify" Command="{Binding UnverifySellerCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============ Brand & Layout ============ -->
                <Grid Visibility="{Binding IsChecked, ElementName=NavBrand, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <TextBlock Text="Brands" Style="{StaticResource SectionTitle}"/>
                            <ListBox ItemsSource="{Binding Brands}" SelectedItem="{Binding SelectedBrand}" Height="180" DisplayMemberPath="BrandName"/>
                            <TextBlock Text="Ten brand" Style="{StaticResource FieldLabel}" Margin="0,10,0,3"/>
                            <TextBox Text="{Binding BrandEditor.BrandName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                            <TextBlock Text="Quoc gia" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding BrandEditor.Country, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                            <WrapPanel>
                                <Button Content="Moi" Command="{Binding NewBrandCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                                <Button Content="Luu brand" Command="{Binding SaveBrandCommand}" Style="{StaticResource PrimaryButton}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <TextBlock Text="Layouts" Style="{StaticResource SectionTitle}"/>
                            <ListBox ItemsSource="{Binding Layouts}" SelectedItem="{Binding SelectedLayout}" Height="180" DisplayMemberPath="LayoutName"/>
                            <TextBlock Text="Layout id" Style="{StaticResource FieldLabel}" Margin="0,10,0,3"/>
                            <TextBox Text="{Binding LayoutEditor.LayoutId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                            <TextBlock Text="Ten" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding LayoutEditor.LayoutName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                            <TextBlock Text="Form factor" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding LayoutEditor.FormFactor, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                            <TextBlock Text="Key count" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding LayoutEditor.KeyCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                            <WrapPanel>
                                <Button Content="Moi" Command="{Binding NewLayoutCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                                <Button Content="Luu layout" Command="{Binding SaveLayoutCommand}" Style="{StaticResource PrimaryButton}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============ Linh kien ============ -->
                <Grid Visibility="{Binding IsChecked, ElementName=NavComponent, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource DashboardCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,10">
                                <ComboBox DockPanel.Dock="Right" Width="160" ItemsSource="{Binding ComponentTypes}" SelectedItem="{Binding SelectedComponentType}"/>
                                <TextBlock Text="Linh kien" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Components}" SelectedItem="{Binding SelectedComponent}" AlternationCount="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="TEN" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="ID" Binding="{Binding ComponentId}" Width="*"/>
                                    <DataGridTextColumn Header="GIA (USD)" Binding="{Binding PriceUsd, StringFormat=N2}" Width="90">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="CO SAN" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource BadgeChrome}" Background="{Binding IsAvailable, Converter={StaticResource BoolToBadgeBrush}}">
                                                    <TextBlock Style="{StaticResource StatusBadgeText}"
                                                               Text="{Binding IsAvailable, Converter={StaticResource BoolToLabel}, ConverterParameter='Co|An'}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                                <Button Content="An" Command="{Binding HideComponentCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                                <Button Content="Khoi phuc" Command="{Binding RestoreComponentCommand}" Style="{StaticResource SecondaryButton}"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource DashboardCard}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Editor linh kien" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Component id" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding ComponentEditor.ComponentId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                                <TextBlock Text="Ten" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding ComponentEditor.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                                <TextBlock Text="Gia (USD)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding ComponentEditor.PriceUsd, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                                <CheckBox Content="Available" IsChecked="{Binding ComponentEditor.IsAvailable}" Margin="0,0,0,10"/>

                                <StackPanel Visibility="{Binding BrandFieldVisibility}">
                                    <TextBlock Text="Brand" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding Brands}" SelectedValue="{Binding ComponentEditor.BrandId}"
                                              SelectedValuePath="BrandId" DisplayMemberPath="BrandName" Margin="0,0,0,10"/>
                                </StackPanel>

                                <!-- Kit -->
                                <StackPanel Visibility="{Binding KitFieldsVisibility}">
                                    <TextBlock Text="Layout" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding Layouts}" SelectedValue="{Binding ComponentEditor.LayoutId}"
                                              SelectedValuePath="LayoutId" DisplayMemberPath="LayoutName" Margin="0,0,0,10"/>
                                    <TextBlock Text="PCB technology" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding ComponentEditor.PcbTechnology, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                                    <TextBlock Text="Switch mount" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding ComponentEditor.SwitchMount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                                    <TextBlock Text="Required switch quantity" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding ComponentEditor.RequiredSwitchQuantity, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                                    <TextBlock Text="Included parts" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding ComponentEditor.IncludedParts, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Switch -->
                                <StackPanel Visibility="{Binding SwitchFieldsVisibility}">
                                    <TextBlock Text="Switch technology" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding ComponentEditor.SwitchTechnology, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                                    <TextBlock Text="Mount type" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding ComponentEditor.MountType, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                                    <TextBlock Text="Switch type" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding ComponentEditor.SwitchType, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                                    <TextBlock Text="Actuation force (g)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding ComponentEditor.ActuationForceG, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Margin="0,0,0,10"/>
                                </StackPanel>

                                <!-- Keycap -->
                                <StackPanel Visibility="{Binding KeycapFieldsVisibility}">
                                    <TextBlock Text="Supported form factor" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding ComponentEditor.SupportedFormFactor, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                                    <TextBlock Text="Profile" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding ComponentEditor.Profile, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                                    <TextBlock Text="Material" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding ComponentEditor.Material, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                                </StackPanel>

                                <!-- Stabilizer -->
                                <StackPanel Visibility="{Binding StabilizerFieldsVisibility}">
                                    <TextBlock Text="Supported layouts" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding ComponentEditor.SupportedLayouts, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                                </StackPanel>

                                <!-- Accessory -->
                                <StackPanel Visibility="{Binding AccessoryFieldsVisibility}">
                                    <TextBlock Text="Accessory type" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding ComponentEditor.AccessoryType, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                                    <TextBlock Text="Target component" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding ComponentEditor.TargetComponent, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                                </StackPanel>

                                <WrapPanel Margin="0,4,0,0">
                                    <Button Content="Moi" Command="{Binding NewComponentCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                                    <Button Content="Luu linh kien" Command="{Binding SaveComponentCommand}" Style="{StaticResource PrimaryButton}"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ============ Audit log ============ -->
                <Border Visibility="{Binding IsChecked, ElementName=NavAudit, Converter={StaticResource BoolToVis}}"
                        Style="{StaticResource DashboardCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="Refresh audit" Command="{Binding RefreshAuditCommand}"
                                    Style="{StaticResource SecondaryButton}"/>
                            <TextBlock Text="Audit log" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding AuditLogs}" AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ACTION" Binding="{Binding Action}" Width="160"/>
                                <DataGridTextColumn Header="BANG" Binding="{Binding TableName}" Width="*"/>
                                <DataGridTextColumn Header="RECORD" Binding="{Binding RecordId}" Width="120"/>
                                <DataGridTextColumn Header="THOI GIAN" Binding="{Binding ChangedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="160"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- ============ Chat ============ -->
                <Border Visibility="{Binding IsChecked, ElementName=NavChat, Converter={StaticResource BoolToVis}}"
                        Background="{StaticResource BodyBgBrush}">
                    <views:ChatView DataContext="{Binding Chat}"/>
                </Border>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="3" Margin="0,12,0,0" Background="#EEF2F6" CornerRadius="4" Padding="12,8">
                <StackPanel Orientation="Horizontal">
                    <Border Width="4" Background="{StaticResource AccentBrush}" CornerRadius="2" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
