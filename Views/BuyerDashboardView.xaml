<UserControl x:Class="Custom_keyboard.Views.BuyerDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Custom_keyboard.Views"
             xmlns:vm="clr-namespace:Custom_keyboard.ViewModels"
             xmlns:loc="clr-namespace:Custom_keyboard.Localization"
             AutomationProperties.AutomationId="BuyerDashboardRoot"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <!-- Sidebar nav buttons that light up when their screen is active -->
        <Style x:Key="NavHome" TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HomeVisibility}" Value="Visible">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavBuildList" TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding BuildListVisibility}" Value="Visible">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavConfigurator" TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ConfiguratorVisibility}" Value="Visible">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavRequests" TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SentRequestsVisibility}" Value="Visible">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavChat" TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ChatVisibility}" Value="Visible">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavRegisterSeller" TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding RegisterSellerVisibility}" Value="Visible">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BodyBgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource SidebarBgBrush}" Padding="18">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                        <Border Width="30" Height="30" CornerRadius="6"
                                Background="{StaticResource AccentBrush}" Margin="0,0,10,0">
                            <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets"
                                       Foreground="White" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{loc:Tr Common_AppName}"
                                   Foreground="{StaticResource SidebarTextBrush}"
                                   FontSize="20" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{loc:Tr Buyer_Workspace}"
                               Foreground="#AFC1D0"
                               FontSize="12"
                               Margin="0,0,0,24"/>

                    <Button Content="{loc:Tr Buyer_NavHome}" Command="{Binding ShowHomeCommand}" Style="{StaticResource NavHome}"/>
                    <Button Content="{loc:Tr Buyer_NavMyBuilds}" Command="{Binding ShowBuildListCommand}" Style="{StaticResource NavBuildList}"/>
                    <Button Content="{loc:Tr Buyer_NavNewBuild}" Command="{Binding NewBuildCommand}" Style="{StaticResource NavConfigurator}"/>
                    <Button x:Name="BuyerSentRequestsNavButton" Content="{loc:Tr Buyer_NavSentRequests}" Command="{Binding ShowSentRequestsCommand}" Style="{StaticResource NavRequests}"/>
                    <Button Content="{loc:Tr Nav_Chat}" Command="{Binding ShowChatCommand}" Style="{StaticResource NavChat}"/>
                    <Button Content="{loc:Tr Buyer_NavRegisterSeller}" Command="{Binding ShowRegisterSellerCommand}" Style="{StaticResource NavRegisterSeller}"/>
                </StackPanel>

                <Border DockPanel.Dock="Bottom"
                        Background="{StaticResource SidebarBgAltBrush}"
                        CornerRadius="4"
                        Padding="12">
                    <StackPanel>
                        <TextBlock Text="{Binding UserMenuHeader}"
                                   Foreground="{StaticResource SidebarTextBrush}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{loc:Tr Common_Online}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Topbar -->
            <DockPanel Margin="0,0,0,16">
                <views:UserMenuView DockPanel.Dock="Right"/>
                <Button DockPanel.Dock="Right" Content="{loc:Tr Common_Refresh}"
                        Command="{Binding RefreshAllCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding Subtitle}" Margin="0,4,0,0" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">
                <!-- Home -->
                <Border Visibility="{Binding HomeVisibility}" Style="{StaticResource DashboardCard}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{Binding UserMenuHeader}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{loc:Tr Buyer_Workflow}" FontWeight="SemiBold" Margin="0,4,0,12"/>
                        <ItemsControl ItemsSource="{Binding Tasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="6" Height="6" CornerRadius="3"
                                                Background="{StaticResource AccentBrush}"
                                                VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Build list -->
                <Border Visibility="{Binding BuildListVisibility}" Style="{StaticResource DashboardCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="{loc:Tr Buyer_NewBuildPlus}"
                                    Command="{Binding NewBuildCommand}"
                                    Style="{StaticResource PrimaryButton}"/>
                            <TextBlock Text="{loc:Tr Buyer_NavMyBuilds}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                        </DockPanel>

                        <Grid Grid.Row="1">
                        <DataGrid x:Name="BuyerBuildsGrid"
                                  ItemsSource="{Binding Builds}"
                                  SelectedItem="{Binding SelectedBuild}"
                                  AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Tr Buyer_ColBuildName}" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="{loc:Tr Buyer_ColKit}" Binding="{Binding KitId}" Width="120"/>
                                <DataGridTemplateColumn Header="{loc:Tr Common_ColStatus}" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource StatusBadge}">
                                                <TextBlock Style="{StaticResource StatusBadgeText}">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource LocalizedStatus}">
                                                            <Binding Path="Status"/>
                                                            <Binding Path="Language" Source="{x:Static loc:Loc.Instance}"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{loc:Tr Buyer_ColTotal}" Binding="{Binding TotalCostSnapshot, StringFormat=N2}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Style="{StaticResource EmptyStateCard}"
                                Visibility="{Binding Items.Count, ElementName=BuyerBuildsGrid, Converter={StaticResource CountToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr Buyer_EmptyBuildsTitle}" Style="{StaticResource EmptyStateTitle}"/>
                                <TextBlock Text="{loc:Tr Buyer_EmptyBuildsText}"
                                           Style="{StaticResource EmptyStateText}"/>
                            </StackPanel>
                        </Border>
                        </Grid>

                        <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                            <Button Content="{loc:Tr Buyer_OpenInConfigurator}" Command="{Binding OpenBuildCommand}"
                                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                            <Button Content="{loc:Tr Buyer_Archive}" Command="{Binding ArchiveBuildCommand}"
                                    Style="{StaticResource SecondaryButton}"/>
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- Configurator -->
                <Border Visibility="{Binding ConfiguratorVisibility}" Style="{StaticResource DashboardCard}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="320"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: selections -->
                            <StackPanel>
                                <TextBlock Text="{loc:Tr Buyer_ConfigTitle}" Style="{StaticResource SectionTitle}"/>

                                <TextBlock Text="{loc:Tr Buyer_BuildNameLabel}" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding BuildName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                                <TextBlock Text="{loc:Tr Common_Notes}" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding BuildNotes, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"
                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="48"/>

                                <TextBlock Text="{loc:Tr Buyer_NoiseRequirementLabel}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding NoiseRequirements}"
                                          SelectedItem="{Binding SelectedNoiseRequirement}"
                                          Margin="0,0,0,12"/>

                                <TextBlock Text="{loc:Tr Buyer_KitLabel}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Kits}" SelectedItem="{Binding SelectedKit}" DisplayMemberPath="KitName" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding KitSummary}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <TextBlock Text="{loc:Tr Buyer_SwitchLabel}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding CompatibleSwitches}" SelectedItem="{Binding SelectedSwitch}" DisplayMemberPath="SwitchName" Margin="0,0,0,8"/>
                                <DockPanel Margin="0,0,0,12">
                                    <Button DockPanel.Dock="Right" Content="{loc:Tr Buyer_UseKitQuantity}"
                                            Command="{Binding ApplyRequiredSwitchQuantityCommand}"
                                            Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" VerticalAlignment="Bottom"/>
                                    <StackPanel>
                                        <TextBlock Text="{loc:Tr Buyer_SwitchQuantityLabel}" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding SwitchQuantity, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </DockPanel>

                                <TextBlock Text="{loc:Tr Buyer_KeycapLabel}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Keycaps}" SelectedItem="{Binding SelectedKeycap}" DisplayMemberPath="KeycapName" Margin="0,0,0,12"/>

                                <TextBlock Text="{loc:Tr Buyer_StabilizerLabel}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Stabilizers}" SelectedItem="{Binding SelectedStabilizer}" DisplayMemberPath="StabilizerName" Margin="0,0,0,12"/>

                                <TextBlock Text="{loc:Tr Buyer_AccessoryLabel}" Style="{StaticResource FieldLabel}"/>
                                <ItemsControl ItemsSource="{Binding Accessories}" Margin="0,0,0,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}" Margin="0,3"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Content="{loc:Tr Buyer_RemoveSelectedMod}" Command="{Binding RemoveModCommand}"
                                            Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                                    <TextBlock Text="{loc:Tr Buyer_ModPresets}" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center"/>
                                </DockPanel>
                                <WrapPanel Margin="0,0,0,8">
                                    <Button Content="{loc:Tr Buyer_ModPresetSwitchLube}" Command="{Binding AddModCommand}" CommandParameter="Switch|Lube"
                                            Style="{StaticResource SecondaryButton}" Margin="0,0,6,6"/>
                                    <Button Content="{loc:Tr Buyer_ModPresetSwitchFilm}" Command="{Binding AddModCommand}" CommandParameter="Switch|Film"
                                            Style="{StaticResource SecondaryButton}" Margin="0,0,6,6"/>
                                    <Button Content="{loc:Tr Buyer_ModPresetSpringSwap}" Command="{Binding AddModCommand}" CommandParameter="Switch|Spring_swap"
                                            Style="{StaticResource SecondaryButton}" Margin="0,0,6,6"/>
                                    <Button Content="{loc:Tr Buyer_ModPresetStabLube}" Command="{Binding AddModCommand}" CommandParameter="Stabilizer|Lube"
                                            Style="{StaticResource SecondaryButton}" Margin="0,0,6,6"/>
                                    <Button Content="{loc:Tr Buyer_ModPresetStabTune}" Command="{Binding AddModCommand}" CommandParameter="Stabilizer|Tune"
                                            Style="{StaticResource SecondaryButton}" Margin="0,0,6,6"/>
                                    <Button Content="{loc:Tr Buyer_ModPresetTapeMod}" Command="{Binding AddModCommand}" CommandParameter="Build|Tape_mod"
                                            Style="{StaticResource SecondaryButton}" Margin="0,0,6,6"/>
                                    <Button Content="{loc:Tr Buyer_ModPresetFoamMod}" Command="{Binding AddModCommand}" CommandParameter="Build|Foam_mod"
                                            Style="{StaticResource SecondaryButton}" Margin="0,0,6,6"/>
                                </WrapPanel>
                                <ListBox ItemsSource="{Binding Mods}" SelectedItem="{Binding SelectedMod}" MaxHeight="240">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FAFC"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="10"
                                                    Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                                        <TextBlock Text="{Binding DisplayTitle}"
                                                                   DockPanel.Dock="Left"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock DockPanel.Dock="Right"
                                                                   Text="{Binding DisplaySummary}"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="220"/>
                                                    </DockPanel>

                                                    <Grid Grid.Row="1" Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="130"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="110"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Margin="0,0,8,0">
                                                            <TextBlock Text="{loc:Tr Buyer_ModTarget}" Style="{StaticResource FieldLabel}"/>
                                                            <ComboBox ItemsSource="{x:Static vm:BuildModEditorViewModel.TargetComponents}"
                                                                      SelectedItem="{Binding TargetComponent}">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock>
                                                                            <TextBlock.Text>
                                                                                <MultiBinding Converter="{StaticResource LocalizedModToken}">
                                                                                    <Binding/>
                                                                                    <Binding Source="{x:Static loc:Loc.Instance}" Path="Language"/>
                                                                                </MultiBinding>
                                                                            </TextBlock.Text>
                                                                        </TextBlock>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                            <TextBlock Text="{loc:Tr Buyer_ModType}" Style="{StaticResource FieldLabel}"/>
                                                            <ComboBox ItemsSource="{Binding AvailableModTypes}"
                                                                      SelectedItem="{Binding ModType}">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock>
                                                                            <TextBlock.Text>
                                                                                <MultiBinding Converter="{StaticResource LocalizedModToken}">
                                                                                    <Binding/>
                                                                                    <Binding Source="{x:Static loc:Loc.Instance}" Path="Language"/>
                                                                                </MultiBinding>
                                                                            </TextBlock.Text>
                                                                        </TextBlock>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2"
                                                                    Margin="0,0,8,0"
                                                                    Visibility="{Binding SwitchQuantityVisibility}">
                                                            <TextBlock Text="{loc:Tr Buyer_ModSwitchCount}" Style="{StaticResource FieldLabel}"/>
                                                            <ComboBox ItemsSource="{Binding QuantityOptions}"
                                                                      SelectedItem="{Binding ModQuantity}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3"
                                                                    Visibility="{Binding SpringWeightVisibility}">
                                                            <TextBlock Text="{loc:Tr Buyer_ModGram}" Style="{StaticResource FieldLabel}"/>
                                                            <ComboBox ItemsSource="{x:Static vm:BuildModEditorViewModel.SpringWeightOptions}"
                                                                      SelectedItem="{Binding SpringWeightG}"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <TextBox Grid.Row="2"
                                                             Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="{loc:Tr Buyer_ModNotesTooltip}"
                                                             MinHeight="34"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <!-- Right: total + validation + actions -->
                            <StackPanel Grid.Column="2">
                                <Border Background="{StaticResource AccentBrush}" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Tr Buyer_TotalSnapshotLabel}" Foreground="#D6F5EE" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding TotalPreview, StringFormat={}{0:N2} USD}" Foreground="White" FontSize="26" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <ItemsControl ItemsSource="{Binding Errors}" Margin="0,0,0,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FDECEA" CornerRadius="4" Padding="8,5" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" FontSize="12"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,0,0,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FEF5E7" CornerRadius="4" Padding="8,5" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" FontSize="12"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding Infos}" Margin="0,0,0,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,3"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Content="{loc:Tr Buyer_SaveBuild}" Command="{Binding SaveBuildCommand}"
                                        Style="{StaticResource SuccessButton}" Margin="0,0,0,18"/>

                                <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Tr Buyer_SendRequestSection}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <ComboBox ItemsSource="{Binding AvailableSellers}" SelectedItem="{Binding SelectedSeller}" DisplayMemberPath="ShopName" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding SellerEmptyMessage}" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap"/>

                                        <!-- Public seller stats (no revenue) -->
                                        <Border Visibility="{Binding SellerStatsVisibility}"
                                                Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="6" Padding="10" Margin="0,2,0,8">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,8">
                                                    <Border DockPanel.Dock="Right" Style="{StaticResource BadgeChrome}"
                                                            Background="{Binding SellerStats.IsVerified, Converter={StaticResource BoolToBadgeBrush}}">
                                                        <TextBlock Style="{StaticResource StatusBadgeText}">
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{StaticResource LocalizedBoolLabel}" ConverterParameter="Common_Verified|Common_Unverified">
                                                                    <Binding Path="SellerStats.IsVerified"/>
                                                                    <Binding Path="Language" Source="{x:Static loc:Loc.Instance}"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </Border>
                                                    <TextBlock Text="{loc:Tr Buyer_SellerReputation}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <DockPanel Margin="0,0,0,3">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SellerStats.ProductsMade}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{loc:Tr Buyer_SellerProductsMade}" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                                </DockPanel>
                                                <DockPanel Margin="0,0,0,3">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SellerStats.TotalOrders}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{loc:Tr Buyer_SellerTotalOrders}" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                                </DockPanel>
                                                <DockPanel Margin="0,0,0,3">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SellerStats.Customers}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{loc:Tr Buyer_SellerCustomers}" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                                </DockPanel>
                                                <DockPanel Margin="0,0,0,3">
                                                    <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0:N1} {1}">
                                                                <Binding Path="SellerStats.AvgCompletionDays" TargetNullValue="-"/>
                                                                <Binding Path="[Common_DaysUnit]" Source="{x:Static loc:Loc.Instance}"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                    <TextBlock Text="{loc:Tr Buyer_SellerAvgCompletion}" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                                </DockPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold"
                                                               Text="{Binding SellerStats.VerifiedAt, StringFormat=yyyy-MM-dd, TargetNullValue=-}"/>
                                                    <TextBlock Text="{loc:Tr Buyer_SellerMemberSince}" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                        <TextBox Text="{Binding RequestNote, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,8"
                                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="44"/>
                                        <Button Content="{loc:Tr Buyer_SendRequest}" Command="{Binding SendRequestCommand}"
                                                Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Border>

                <!-- Sent requests -->
                <Border Visibility="{Binding SentRequestsVisibility}" Style="{StaticResource DashboardCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{loc:Tr Buyer_NavSentRequests}" Style="{StaticResource SectionTitle}"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="300"/>
                            </Grid.ColumnDefinitions>

                            <Grid>
                                <DataGrid x:Name="BuyerRequestsGrid"
                                          ItemsSource="{Binding Requests}"
                                          SelectedItem="{Binding SelectedRequest, Mode=TwoWay}"
                                          AlternationCount="2">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{loc:Tr Common_ColRequest}" Binding="{Binding RequestId}" Width="*"/>
                                        <DataGridTextColumn Header="{loc:Tr Common_ColBuild}" Binding="{Binding BuildId}" Width="*"/>
                                        <DataGridTextColumn Header="{loc:Tr Common_ColSeller}" Binding="{Binding SellerUserId}" Width="90"/>
                                        <DataGridTemplateColumn Header="{loc:Tr Common_ColStatus}" Width="130">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource StatusBadge}">
                                                        <TextBlock Style="{StaticResource StatusBadgeText}">
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{StaticResource LocalizedStatus}">
                                                                    <Binding Path="Status"/>
                                                                    <Binding Path="Language" Source="{x:Static loc:Loc.Instance}"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Style="{StaticResource EmptyStateCard}"
                                        Visibility="{Binding Items.Count, ElementName=BuyerRequestsGrid, Converter={StaticResource CountToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Tr Buyer_EmptyRequestsTitle}" Style="{StaticResource EmptyStateTitle}"/>
                                        <TextBlock Text="{loc:Tr Buyer_EmptyRequestsText}"
                                                   Style="{StaticResource EmptyStateText}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- QC summary for the selected request (read-only; no per-key detail for buyers) -->
                            <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="14" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr QcTest_Summary}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>

                                    <StackPanel AutomationProperties.AutomationId="BuyerQcSummaryPanel"
                                                Visibility="{Binding SelectedRequestQcVisibility}">
                                        <DockPanel Margin="0,0,0,8">
                                            <Border DockPanel.Dock="Right" Style="{StaticResource BadgeChrome}"
                                                    Background="{Binding SelectedRequestQc.Status, Converter={StaticResource StatusToBrushConverter}}">
                                                <TextBlock Style="{StaticResource StatusBadgeText}">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource LocalizedStatus}">
                                                            <Binding Path="SelectedRequestQc.Status"/>
                                                            <Binding Path="Language" Source="{x:Static loc:Loc.Instance}"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Border>
                                            <TextBlock AutomationProperties.AutomationId="BuyerQcSummaryStatusLabel"
                                                       Text="{loc:Tr QcTest_Status}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,3">
                                            <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0}/{1}">
                                                        <Binding Path="SelectedRequestQc.PassedKeys"/>
                                                        <Binding Path="SelectedRequestQc.TotalKeys"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock Text="{loc:Tr QcTest_Passed}" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,3">
                                            <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold"
                                                       Text="{Binding SelectedRequestQc.AverageLatencyMs, StringFormat=N2, TargetNullValue=-}"/>
                                            <TextBlock Text="{loc:Tr QcTest_AvgLatency}" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                        </DockPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold"
                                                       Text="{Binding SelectedRequestQc.AverageNoiseDb, StringFormat=N2, TargetNullValue=-}"/>
                                            <TextBlock Text="{loc:Tr QcTest_AvgNoise}" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                        </DockPanel>
                                    </StackPanel>

                                    <TextBlock AutomationProperties.AutomationId="BuyerQcNoDataMessage"
                                               Text="{loc:Tr QcTest_NoData}" Foreground="{StaticResource TextMutedBrush}"
                                               TextWrapping="Wrap" Visibility="{Binding SelectedRequestQcEmptyVisibility}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Chat -->
                <Border Visibility="{Binding ChatVisibility}" Background="{StaticResource BodyBgBrush}">
                    <views:ChatView DataContext="{Binding Chat}"/>
                </Border>

                <!-- Register as seller -->
                <Border Visibility="{Binding RegisterSellerVisibility}" Style="{StaticResource DashboardCard}" VerticalAlignment="Top">
                    <Grid MaxWidth="560" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr Buyer_BecomeSellerTitle}" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{loc:Tr Buyer_BecomeSellerDesc}"
                                       Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                            <!-- Current application status -->
                            <Border Background="#EEF2F6" CornerRadius="4" Padding="12,10" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource StatusBadge}"
                                            Visibility="{Binding HasMyApplication, Converter={StaticResource BoolToVis}}"
                                            DataContext="{Binding MyApplication}">
                                        <TextBlock Style="{StaticResource StatusBadgeText}">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource LocalizedStatus}">
                                                    <Binding Path="Status"/>
                                                    <Binding Path="Language" Source="{x:Static loc:Loc.Instance}"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Text="{Binding MyApplicationStatusText}" Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{loc:Tr Common_ShopName}" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding SellerAppShopName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                            <TextBlock Text="{loc:Tr Common_Phone}" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding SellerAppPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                            <TextBlock Text="{loc:Tr Common_Address}" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding SellerAppAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"
                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="44"/>

                            <TextBlock Text="{loc:Tr Buyer_NoteOptional}" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding SellerAppNote, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"
                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="44"/>

                            <Button Content="{loc:Tr Buyer_SubmitApplication}" Command="{Binding SubmitSellerApplicationCommand}"
                                    Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="2" Margin="0,12,0,0" Background="#EEF2F6" CornerRadius="4" Padding="12,8">
                <DockPanel>
                    <Border DockPanel.Dock="Right"
                            Style="{StaticResource BadgeChrome}"
                            Background="{StaticResource AccentBrush}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:Tr Common_Processing}" Style="{StaticResource StatusBadgeText}"/>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="4" Background="{StaticResource AccentBrush}" CornerRadius="2" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
