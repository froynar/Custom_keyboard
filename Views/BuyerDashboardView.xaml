<UserControl x:Class="Custom_keyboard.Views.BuyerDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Custom_keyboard.Views"
             xmlns:vm="clr-namespace:Custom_keyboard.ViewModels"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <!-- Sidebar nav buttons that light up when their screen is active -->
        <Style x:Key="NavHome" TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HomeVisibility}" Value="Visible">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavBuildList" TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding BuildListVisibility}" Value="Visible">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavConfigurator" TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ConfiguratorVisibility}" Value="Visible">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavRequests" TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SentRequestsVisibility}" Value="Visible">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavChat" TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ChatVisibility}" Value="Visible">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BodyBgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource SidebarBgBrush}" Padding="18">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                        <Border Width="30" Height="30" CornerRadius="6"
                                Background="{StaticResource AccentBrush}" Margin="0,0,10,0">
                            <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets"
                                       Foreground="White" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="CK Builder"
                                   Foreground="{StaticResource SidebarTextBrush}"
                                   FontSize="20" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Buyer workspace"
                               Foreground="#AFC1D0"
                               FontSize="12"
                               Margin="0,0,0,24"/>

                    <Button Content="Trang chu" Command="{Binding ShowHomeCommand}" Style="{StaticResource NavHome}"/>
                    <Button Content="Build cua toi" Command="{Binding ShowBuildListCommand}" Style="{StaticResource NavBuildList}"/>
                    <Button Content="Tao build moi" Command="{Binding NewBuildCommand}" Style="{StaticResource NavConfigurator}"/>
                    <Button Content="Request da gui" Command="{Binding ShowSentRequestsCommand}" Style="{StaticResource NavRequests}"/>
                    <Button Content="Chat" Command="{Binding ShowChatCommand}" Style="{StaticResource NavChat}"/>
                </StackPanel>

                <Border DockPanel.Dock="Bottom"
                        Background="{StaticResource SidebarBgAltBrush}"
                        CornerRadius="4"
                        Padding="12">
                    <StackPanel>
                        <TextBlock Text="{Binding UserMenuHeader}"
                                   Foreground="{StaticResource SidebarTextBrush}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Online"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Topbar -->
            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Content="Dang xuat"
                        Command="{Binding LogoutCommand}"
                        Style="{StaticResource SecondaryButton}"/>
                <Button DockPanel.Dock="Right" Content="Refresh"
                        Command="{Binding RefreshAllCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding Subtitle}" Margin="0,4,0,0" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">
                <!-- Home -->
                <Border Visibility="{Binding HomeVisibility}" Style="{StaticResource DashboardCard}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{Binding UserMenuHeader}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Quy trinh buyer" FontWeight="SemiBold" Margin="0,4,0,12"/>
                        <ItemsControl ItemsSource="{Binding Tasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="6" Height="6" CornerRadius="3"
                                                Background="{StaticResource AccentBrush}"
                                                VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Build list -->
                <Border Visibility="{Binding BuildListVisibility}" Style="{StaticResource DashboardCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="+ Tao build moi"
                                    Command="{Binding NewBuildCommand}"
                                    Style="{StaticResource PrimaryButton}"/>
                            <TextBlock Text="Build cua toi" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                        </DockPanel>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Builds}"
                                  SelectedItem="{Binding SelectedBuild}"
                                  AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="TEN BUILD" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="KIT" Binding="{Binding KitId}" Width="120"/>
                                <DataGridTemplateColumn Header="TRANG THAI" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource StatusBadge}">
                                                <TextBlock Text="{Binding Status, Converter={StaticResource StatusToTextConverter}}"
                                                           Style="{StaticResource StatusBadgeText}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="TONG (USD)" Binding="{Binding TotalCostSnapshot, StringFormat=N2}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                            <Button Content="Mo trong configurator" Command="{Binding OpenBuildCommand}"
                                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                            <Button Content="Archive" Command="{Binding ArchiveBuildCommand}"
                                    Style="{StaticResource SecondaryButton}"/>
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- Configurator -->
                <Border Visibility="{Binding ConfiguratorVisibility}" Style="{StaticResource DashboardCard}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="320"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: selections -->
                            <StackPanel>
                                <TextBlock Text="Cau hinh build" Style="{StaticResource SectionTitle}"/>

                                <TextBlock Text="Ten build" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding BuildName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                                <TextBlock Text="Ghi chu" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding BuildNotes, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"
                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="48"/>

                                <TextBlock Text="Kit" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Kits}" SelectedItem="{Binding SelectedKit}" DisplayMemberPath="KitName" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding KitSummary}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <TextBlock Text="Switch" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Switches}" SelectedItem="{Binding SelectedSwitch}" DisplayMemberPath="SwitchName" Margin="0,0,0,8"/>
                                <DockPanel Margin="0,0,0,12">
                                    <Button DockPanel.Dock="Right" Content="Dung so luong kit"
                                            Command="{Binding ApplyRequiredSwitchQuantityCommand}"
                                            Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" VerticalAlignment="Bottom"/>
                                    <StackPanel>
                                        <TextBlock Text="So luong switch" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding SwitchQuantity, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </DockPanel>

                                <TextBlock Text="Keycap" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Keycaps}" SelectedItem="{Binding SelectedKeycap}" DisplayMemberPath="KeycapName" Margin="0,0,0,12"/>

                                <TextBlock Text="Stabilizer" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Stabilizers}" SelectedItem="{Binding SelectedStabilizer}" DisplayMemberPath="StabilizerName" Margin="0,0,0,12"/>

                                <TextBlock Text="Accessory" Style="{StaticResource FieldLabel}"/>
                                <ItemsControl ItemsSource="{Binding Accessories}" Margin="0,0,0,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}" Margin="0,3"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Content="Xoa mod" Command="{Binding RemoveModCommand}"
                                            Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                                    <Button DockPanel.Dock="Right" Content="Them mod" Command="{Binding AddModCommand}"
                                            Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                                    <TextBlock Text="Mod" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ListBox ItemsSource="{Binding Mods}" SelectedItem="{Binding SelectedMod}" MaxHeight="180">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox ItemsSource="{x:Static vm:BuildModEditorViewModel.ModTypes}"
                                                          SelectedItem="{Binding ModType}" Margin="0,0,6,0"/>
                                                <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:BuildModEditorViewModel.TargetComponents}"
                                                          SelectedItem="{Binding TargetComponent}" Margin="0,0,6,0"/>
                                                <TextBox Grid.Column="2" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <!-- Right: total + validation + actions -->
                            <StackPanel Grid.Column="2">
                                <Border Background="{StaticResource AccentBrush}" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="TONG GIA (SNAPSHOT)" Foreground="#D6F5EE" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding TotalPreview, StringFormat={}{0:N2} USD}" Foreground="White" FontSize="26" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <ItemsControl ItemsSource="{Binding Errors}" Margin="0,0,0,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FDECEA" CornerRadius="4" Padding="8,5" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" FontSize="12"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,0,0,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FEF5E7" CornerRadius="4" Padding="8,5" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" FontSize="12"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding Infos}" Margin="0,0,0,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,3"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Content="Luu build" Command="{Binding SaveBuildCommand}"
                                        Style="{StaticResource SuccessButton}" Margin="0,0,0,18"/>

                                <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="Gui request cho seller" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <ComboBox ItemsSource="{Binding AvailableSellers}" SelectedItem="{Binding SelectedSeller}" DisplayMemberPath="ShopName" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding SellerEmptyMessage}" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap"/>

                                        <!-- Public seller stats (no revenue) -->
                                        <Border Visibility="{Binding SellerStatsVisibility}"
                                                Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="6" Padding="10" Margin="0,2,0,8">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,8">
                                                    <Border DockPanel.Dock="Right" Style="{StaticResource BadgeChrome}"
                                                            Background="{Binding SellerStats.IsVerified, Converter={StaticResource BoolToBadgeBrush}}">
                                                        <TextBlock Style="{StaticResource StatusBadgeText}"
                                                                   Text="{Binding SellerStats.IsVerified, Converter={StaticResource BoolToLabel}, ConverterParameter='Verified|Chua verify'}"/>
                                                    </Border>
                                                    <TextBlock Text="Uy tin seller" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <DockPanel Margin="0,0,0,3">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SellerStats.ProductsMade}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="San pham da lam" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                                </DockPanel>
                                                <DockPanel Margin="0,0,0,3">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SellerStats.TotalOrders}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Tong don nhan" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                                </DockPanel>
                                                <DockPanel Margin="0,0,0,3">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SellerStats.Customers}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Khach da phuc vu" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                                </DockPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold"
                                                               Text="{Binding SellerStats.VerifiedAt, StringFormat=yyyy-MM-dd, TargetNullValue=-}"/>
                                                    <TextBlock Text="Thanh vien tu" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                        <TextBox Text="{Binding RequestNote, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,8"
                                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="44"/>
                                        <Button Content="Gui request" Command="{Binding SendRequestCommand}"
                                                Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Border>

                <!-- Sent requests -->
                <Border Visibility="{Binding SentRequestsVisibility}" Style="{StaticResource DashboardCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Request da gui" Style="{StaticResource SectionTitle}"/>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Requests}"
                                  AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="REQUEST" Binding="{Binding RequestId}" Width="*"/>
                                <DataGridTextColumn Header="BUILD" Binding="{Binding BuildId}" Width="*"/>
                                <DataGridTextColumn Header="SELLER" Binding="{Binding SellerUserId}" Width="90"/>
                                <DataGridTemplateColumn Header="TRANG THAI" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource StatusBadge}">
                                                <TextBlock Text="{Binding Status, Converter={StaticResource StatusToTextConverter}}"
                                                           Style="{StaticResource StatusBadgeText}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Chat -->
                <Border Visibility="{Binding ChatVisibility}" Background="{StaticResource BodyBgBrush}">
                    <views:ChatView DataContext="{Binding Chat}"/>
                </Border>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="2" Margin="0,12,0,0" Background="#EEF2F6" CornerRadius="4" Padding="12,8">
                <StackPanel Orientation="Horizontal">
                    <Border Width="4" Background="{StaticResource AccentBrush}" CornerRadius="2" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
