<UserControl x:Class="Custom_keyboard.Views.BuyerDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Custom_keyboard.Views"
             xmlns:vm="clr-namespace:Custom_keyboard.ViewModels"
             Loaded="OnLoaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="Dang xuat"
                    Command="{Binding LogoutCommand}"
                    Padding="14,8" Background="#EEF2F6" BorderBrush="#DDE2E8"/>
            <Button DockPanel.Dock="Right" Content="Refresh"
                    Command="{Binding RefreshAllCommand}"
                    Margin="0,0,8,0" Padding="14,8" Background="#EEF2F6" BorderBrush="#DDE2E8"/>
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Foreground="#20242B"/>
                <TextBlock Text="{Binding Subtitle}" Margin="0,4,0,0" Foreground="#687381"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Nav rail -->
            <StackPanel>
                <Button Content="Trang chu" Command="{Binding ShowHomeCommand}" Margin="0,0,0,8" Padding="12,8" HorizontalContentAlignment="Left"/>
                <Button Content="Build cua toi" Command="{Binding ShowBuildListCommand}" Margin="0,0,0,8" Padding="12,8" HorizontalContentAlignment="Left"/>
                <Button Content="Tao build moi" Command="{Binding NewBuildCommand}" Margin="0,0,0,8" Padding="12,8" HorizontalContentAlignment="Left"
                        Background="#2F6FED" Foreground="White" BorderThickness="0"/>
                <Button Content="Request da gui" Command="{Binding ShowSentRequestsCommand}" Margin="0,0,0,8" Padding="12,8" HorizontalContentAlignment="Left"/>
                <Button Content="Chat" Command="{Binding ShowChatCommand}" Margin="0,0,0,8" Padding="12,8" HorizontalContentAlignment="Left"/>
            </StackPanel>

            <!-- Content -->
            <Grid Grid.Column="2">
                <!-- Home -->
                <Border Visibility="{Binding HomeVisibility}" Background="White" BorderBrush="#DDE2E8" BorderThickness="1" Padding="18">
                    <StackPanel>
                        <TextBlock Text="{Binding UserMenuHeader}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Quy trinh buyer" FontWeight="SemiBold" Margin="0,14,0,8"/>
                        <ItemsControl ItemsSource="{Binding Tasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,0,0,8"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Build list -->
                <Border Visibility="{Binding BuildListVisibility}" Background="White" BorderBrush="#DDE2E8" BorderThickness="1" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Build cua toi" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
                        <ListBox Grid.Row="1" ItemsSource="{Binding Builds}" SelectedItem="{Binding SelectedBuild}" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock FontSize="12" Foreground="#687381">
                                            <Run Text="Kit:"/>
                                            <Run Text="{Binding KitId}"/>
                                            <Run Text=" | "/>
                                            <Run Text="{Binding Status}"/>
                                            <Run Text=" | "/>
                                            <Run Text="{Binding TotalCostSnapshot, StringFormat={}{0:F2} USD}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                            <Button Content="Mo trong configurator" Command="{Binding OpenBuildCommand}" Margin="0,0,8,0" Padding="12,6"
                                    Background="#2F6FED" Foreground="White" BorderThickness="0"/>
                            <Button Content="Archive" Command="{Binding ArchiveBuildCommand}" Padding="12,6"
                                    Background="#EEF2F6" BorderBrush="#DDE2E8"/>
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- Configurator -->
                <Border Visibility="{Binding ConfiguratorVisibility}" Background="White" BorderBrush="#DDE2E8" BorderThickness="1" Padding="14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="320"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: selections -->
                            <StackPanel>
                                <TextBlock Text="Cau hinh build" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>

                                <TextBlock Text="Ten build"/>
                                <TextBox Text="{Binding BuildName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10" Padding="6"/>

                                <TextBlock Text="Ghi chu"/>
                                <TextBox Text="{Binding BuildNotes, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10" Padding="6"
                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="48"/>

                                <TextBlock Text="Kit"/>
                                <ComboBox ItemsSource="{Binding Kits}" SelectedItem="{Binding SelectedKit}" DisplayMemberPath="KitName" Margin="0,2,0,4"/>
                                <TextBlock Text="{Binding KitSummary}" Foreground="#687381" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                <TextBlock Text="Switch"/>
                                <ComboBox ItemsSource="{Binding Switches}" SelectedItem="{Binding SelectedSwitch}" DisplayMemberPath="SwitchName" Margin="0,2,0,4"/>
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Content="Dung so luong kit"
                                            Command="{Binding ApplyRequiredSwitchQuantityCommand}"
                                            Margin="8,0,0,0" Padding="10,4" Background="#EEF2F6" BorderBrush="#DDE2E8"/>
                                    <StackPanel>
                                        <TextBlock Text="So luong switch" FontSize="12" Foreground="#687381"/>
                                        <TextBox Text="{Binding SwitchQuantity, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
                                    </StackPanel>
                                </DockPanel>

                                <TextBlock Text="Keycap"/>
                                <ComboBox ItemsSource="{Binding Keycaps}" SelectedItem="{Binding SelectedKeycap}" DisplayMemberPath="KeycapName" Margin="0,2,0,10"/>

                                <TextBlock Text="Stabilizer"/>
                                <ComboBox ItemsSource="{Binding Stabilizers}" SelectedItem="{Binding SelectedStabilizer}" DisplayMemberPath="StabilizerName" Margin="0,2,0,10"/>

                                <TextBlock Text="Accessory" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding Accessories}" Margin="0,0,0,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
                                                <TextBlock>
                                                    <Run Text="{Binding DisplayName}"/>
                                                    <Run Text=" - "/>
                                                    <Run Text="{Binding PriceText}"/>
                                                    <Run Text=" ("/><Run Text="{Binding Target}"/><Run Text=")"/>
                                                </TextBlock>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <DockPanel Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right" Content="Xoa mod" Command="{Binding RemoveModCommand}"
                                            Margin="8,0,0,0" Padding="10,4" Background="#EEF2F6" BorderBrush="#DDE2E8"/>
                                    <Button DockPanel.Dock="Right" Content="Them mod" Command="{Binding AddModCommand}"
                                            Margin="8,0,0,0" Padding="10,4" Background="#EEF2F6" BorderBrush="#DDE2E8"/>
                                    <TextBlock Text="Mod" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ListBox ItemsSource="{Binding Mods}" SelectedItem="{Binding SelectedMod}" BorderThickness="1" BorderBrush="#DDE2E8" MaxHeight="180">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox ItemsSource="{x:Static vm:BuildModEditorViewModel.ModTypes}"
                                                          SelectedItem="{Binding ModType}" Margin="0,0,6,0"/>
                                                <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:BuildModEditorViewModel.TargetComponents}"
                                                          SelectedItem="{Binding TargetComponent}" Margin="0,0,6,0"/>
                                                <TextBox Grid.Column="2" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Padding="4"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <!-- Right: validation + actions -->
                            <StackPanel Grid.Column="2">
                                <Border Background="#F8FAFC" BorderBrush="#DDE2E8" BorderThickness="1" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Tong gia (snapshot)" Foreground="#687381" FontSize="12"/>
                                        <TextBlock Text="{Binding TotalPreview, StringFormat={}{0:F2} USD}" FontSize="22" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Loi" FontWeight="SemiBold" Foreground="#E5484D"/>
                                <ItemsControl ItemsSource="{Binding Errors}" Margin="0,2,0,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="#E5484D" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Canh bao" FontWeight="SemiBold" Foreground="#B7791F"/>
                                <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,2,0,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="#B7791F" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Thong tin" FontWeight="SemiBold" Foreground="#687381"/>
                                <ItemsControl ItemsSource="{Binding Infos}" Margin="0,2,0,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="#687381" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Content="Luu build" Command="{Binding SaveBuildCommand}" Padding="12,8" Margin="0,0,0,16"
                                        Background="#1F9D5B" Foreground="White" BorderThickness="0"/>

                                <TextBlock Text="Gui request cho seller" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding AvailableSellers}" SelectedItem="{Binding SelectedSeller}" DisplayMemberPath="ShopName" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding SellerEmptyMessage}" Foreground="#E5484D" FontSize="12" TextWrapping="Wrap"/>
                                <TextBox Text="{Binding RequestNote, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,4,0,6"
                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="44"/>
                                <Button Content="Gui request" Command="{Binding SendRequestCommand}" Padding="12,8"
                                        Background="#2F6FED" Foreground="White" BorderThickness="0"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Border>

                <!-- Sent requests -->
                <Border Visibility="{Binding SentRequestsVisibility}" Background="White" BorderBrush="#DDE2E8" BorderThickness="1" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Request da gui" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
                        <ListBox Grid.Row="1" ItemsSource="{Binding Requests}" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding RequestId}" FontWeight="SemiBold"/>
                                        <TextBlock FontSize="12" Foreground="#687381">
                                            <Run Text="Build:"/>
                                            <Run Text="{Binding BuildId}"/>
                                            <Run Text=" | seller #"/>
                                            <Run Text="{Binding SellerUserId}"/>
                                            <Run Text=" | "/>
                                            <Run Text="{Binding Status}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Chat -->
                <Border Visibility="{Binding ChatVisibility}" Background="#F6F7F9">
                    <views:ChatView DataContext="{Binding Chat}"/>
                </Border>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Margin="0,12,0,0" Foreground="#687381"/>
    </Grid>
</UserControl>
