<UserControl x:Class="Custom_keyboard.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:Custom_keyboard.Behaviors"
             xmlns:loc="clr-namespace:Custom_keyboard.Localization">
    <Grid Background="{StaticResource AppBackdropBrush}" ClipToBounds="True">
        <Grid Margin="38">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.95*"/>
                <ColumnDefinition Width="34"/>
                <ColumnDefinition Width="1.05*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource HeroCard}" MaxWidth="520" HorizontalAlignment="Stretch">
                <Grid ClipToBounds="True">
                    <Ellipse Width="250" Height="250" Fill="#2563EB" Opacity="0.18"
                             HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-100,-120,0,0"/>
                    <Ellipse Width="220" Height="220" Fill="#B45309" Opacity="0.18"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-80,-90"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,42">
                            <Border Width="46" Height="46" CornerRadius="8"
                                    Background="#CCFBF1" Margin="0,0,14,0">
                                <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets"
                                           Foreground="{StaticResource AccentDarkBrush}" FontSize="22"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr Common_AppName}" FontSize="20" FontWeight="SemiBold"
                                           Foreground="White"/>
                                <TextBlock Text="{loc:Tr Common_AppTagline}" FontSize="12"
                                           Foreground="#C7D2FE"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="500">
                            <TextBlock Text="{loc:Tr Register_Title}"
                                       FontFamily="{StaticResource DisplayFontFamily}"
                                       FontSize="{StaticResource FontSizeHero}"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{loc:Tr Register_Subtitle}"
                                       Margin="0,12,0,0"
                                       FontSize="15"
                                       LineHeight="22"
                                       Foreground="#D1FAE5"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border Grid.Row="2" BorderBrush="#5EEAD4" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,42,0,0" Background="#14313A">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr Common_AppTagline}" Foreground="#F8FAFC" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{loc:Tr Login_CreateBuyerAccount}" Foreground="#A7F3D0" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" VerticalAlignment="Center">
                <Border Width="460"
                        Padding="28"
                        Style="{StaticResource DashboardCard}"
                        HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Register_Title}"
                                   FontSize="{StaticResource FontSizeTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{loc:Tr Register_Subtitle}"
                                   Margin="0,6,0,24"
                                   FontSize="14"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="{loc:Tr Common_Username}" Style="{StaticResource FieldLabel}"/>
                        <TextBox AutomationProperties.AutomationId="RegisterUsernameTextBox"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,12"/>

                        <TextBlock Text="{loc:Tr Common_Email}" Style="{StaticResource FieldLabel}"/>
                        <TextBox AutomationProperties.AutomationId="RegisterEmailTextBox"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,12"/>

                        <TextBlock Text="{loc:Tr Common_Phone}" Style="{StaticResource FieldLabel}"/>
                        <TextBox AutomationProperties.AutomationId="RegisterPhoneTextBox"
                                 Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,12"/>

                        <TextBlock Text="{loc:Tr Common_Password}" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox AutomationProperties.AutomationId="RegisterPasswordBox"
                                     behaviors:PasswordBoxBinding.Attach="True"
                                     behaviors:PasswordBoxBinding.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,12"/>

                        <TextBlock Text="{loc:Tr Register_ConfirmPassword}" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox AutomationProperties.AutomationId="RegisterConfirmPasswordBox"
                                     behaviors:PasswordBoxBinding.Attach="True"
                                     behaviors:PasswordBoxBinding.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,12"/>

                        <TextBlock AutomationProperties.AutomationId="RegisterErrorMessage"
                                   Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource DangerBrush}"
                                   TextWrapping="Wrap"
                                   MinHeight="22"/>

                        <Button AutomationProperties.AutomationId="RegisterSubmitButton"
                                Content="{loc:Tr Register_Submit}"
                                Command="{Binding RegisterCommand}"
                                Margin="0,10,0,10"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Stretch"/>

                        <Button AutomationProperties.AutomationId="RegisterBackToLoginButton"
                                Content="{loc:Tr Register_BackToLogin}"
                                Command="{Binding ShowLoginCommand}"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
