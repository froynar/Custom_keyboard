<UserControl x:Class="Custom_keyboard.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:Custom_keyboard.Behaviors">
    <Grid>
        <Border Width="460"
                Padding="28"
                Background="White"
                BorderBrush="#DDE2E8"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Dang ky buyer"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#20242B"/>
                <TextBlock Text="Tao tai khoan de bat dau build keyboard"
                           Margin="0,4,0,22"
                           FontSize="14"
                           Foreground="#687381"/>

                <TextBlock Text="Username" FontWeight="SemiBold" Foreground="#343A40"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,6,0,12"
                         Padding="10"/>

                <TextBlock Text="Email" FontWeight="SemiBold" Foreground="#343A40"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,6,0,12"
                         Padding="10"/>

                <TextBlock Text="Phone" FontWeight="SemiBold" Foreground="#343A40"/>
                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,6,0,12"
                         Padding="10"/>

                <TextBlock Text="Mat khau" FontWeight="SemiBold" Foreground="#343A40"/>
                <PasswordBox behaviors:PasswordBoxBinding.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,6,0,12"
                             Padding="10"/>

                <TextBlock Text="Xac nhan mat khau" FontWeight="SemiBold" Foreground="#343A40"/>
                <PasswordBox behaviors:PasswordBoxBinding.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,6,0,12"
                             Padding="10"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#B42318"
                           TextWrapping="Wrap"
                           MinHeight="22"/>

                <Button Content="Dang ky"
                        Command="{Binding RegisterCommand}"
                        Margin="0,8,0,10"
                        Padding="12"
                        Background="#20242B"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"/>

                <Button Content="Quay lai dang nhap"
                        Command="{Binding ShowLoginCommand}"
                        Padding="10"
                        Background="#EEF2F6"
                        Foreground="#20242B"
                        BorderBrush="#DDE2E8"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
