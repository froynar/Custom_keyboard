<UserControl x:Class="Custom_keyboard.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:Custom_keyboard.Behaviors"
             xmlns:loc="clr-namespace:Custom_keyboard.Localization">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#EEF2F6" Offset="0"/>
                <GradientStop Color="#F7F7F7" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Border Width="460"
                Padding="30"
                Style="{StaticResource DashboardCard}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Border Width="40" Height="40" CornerRadius="8"
                            Background="{StaticResource AccentBrush}" Margin="0,0,12,0">
                        <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets"
                                   Foreground="White" FontSize="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CK Builder" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Custom Keyboard" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="{loc:Tr Register_Title}"
                           FontSize="{StaticResource FontSizeHero}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{loc:Tr Register_Subtitle}"
                           Margin="0,4,0,22"
                           FontSize="14"
                           Foreground="{StaticResource TextMutedBrush}"/>

                <TextBlock Text="{loc:Tr Common_Username}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBox AutomationProperties.AutomationId="RegisterUsernameTextBox"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,6,0,12"/>

                <TextBlock Text="{loc:Tr Common_Email}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBox AutomationProperties.AutomationId="RegisterEmailTextBox"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,6,0,12"/>

                <TextBlock Text="{loc:Tr Common_Phone}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBox AutomationProperties.AutomationId="RegisterPhoneTextBox"
                         Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,6,0,12"/>

                <TextBlock Text="{loc:Tr Common_Password}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <PasswordBox AutomationProperties.AutomationId="RegisterPasswordBox"
                             behaviors:PasswordBoxBinding.Attach="True"
                             behaviors:PasswordBoxBinding.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,6,0,12"/>

                <TextBlock Text="{loc:Tr Register_ConfirmPassword}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <PasswordBox AutomationProperties.AutomationId="RegisterConfirmPasswordBox"
                             behaviors:PasswordBoxBinding.Attach="True"
                             behaviors:PasswordBoxBinding.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,6,0,12"/>

                <TextBlock AutomationProperties.AutomationId="RegisterErrorMessage"
                           Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap"
                           MinHeight="22"/>

                <Button AutomationProperties.AutomationId="RegisterSubmitButton"
                        Content="{loc:Tr Register_Submit}"
                        Command="{Binding RegisterCommand}"
                        Margin="0,8,0,10"
                        Style="{StaticResource PrimaryButton}"/>

                <Button AutomationProperties.AutomationId="RegisterBackToLoginButton"
                        Content="{loc:Tr Register_BackToLogin}"
                        Command="{Binding ShowLoginCommand}"
                        Style="{StaticResource SecondaryButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
