<UserControl x:Class="Custom_keyboard.Views.SellerDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Custom_keyboard.Views"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:loc="clr-namespace:Custom_keyboard.Localization"
             AutomationProperties.AutomationId="SellerDashboardRoot"
             Loaded="OnLoaded">
    <Grid Background="{StaticResource AppBackdropBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource SidebarGradientBrush}" Padding="18">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                        <Border Width="30" Height="30" CornerRadius="6"
                                Background="{StaticResource AccentBrush}" Margin="0,0,10,0">
                            <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets"
                                       Foreground="White" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{loc:Tr Common_AppName}"
                                   Foreground="{StaticResource SidebarTextBrush}"
                                   FontSize="20" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{loc:Tr Seller_Workspace}"
                               Foreground="{StaticResource SidebarMutedBrush}"
                               FontSize="12"
                               Margin="0,0,0,24"/>

                    <RadioButton x:Name="NavRequest" Content="{loc:Tr Seller_NavRequest}" GroupName="sellerNav"
                                 Style="{StaticResource SidebarNav}" IsChecked="True"/>
                    <RadioButton x:Name="NavQc" Content="{loc:Tr QcTest_NavQc}" GroupName="sellerNav"
                                 Style="{StaticResource SidebarNav}"/>
                    <RadioButton x:Name="NavAnalytics" Content="{loc:Tr Seller_NavAnalytics}" GroupName="sellerNav"
                                 Style="{StaticResource SidebarNav}"/>
                    <RadioButton x:Name="NavChat" Content="{loc:Tr Nav_Chat}" GroupName="sellerNav"
                                 Style="{StaticResource SidebarNav}"/>
                </StackPanel>

                <Border DockPanel.Dock="Bottom"
                        Background="#1F2937" BorderBrush="#334155" BorderThickness="1"
                        CornerRadius="4"
                        Padding="12">
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentUser.Username}"
                                   Foreground="{StaticResource SidebarTextBrush}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{loc:Tr Common_Seller}" Foreground="{StaticResource AccentBrush}" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Topbar -->
            <Border Style="{StaticResource TopBarChrome}" Margin="0,0,0,16">
                <DockPanel>
                <views:UserMenuView DockPanel.Dock="Right"/>
                <Button DockPanel.Dock="Right" Content="{loc:Tr Common_Refresh}"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding Subtitle}" Margin="0,4,0,0" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
            </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <!-- Request section -->
                <Grid Visibility="{Binding IsChecked, ElementName=NavRequest, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="440"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Request list + state machine -->
                    <Border Style="{StaticResource DashboardCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="{loc:Tr Seller_AssignedRequests}" Style="{StaticResource SectionTitle}"/>

                            <Grid Grid.Row="1">
                            <DataGrid x:Name="SellerRequestsGrid"
                                      ItemsSource="{Binding Requests}"
                                      SelectedItem="{Binding SelectedRequest}"
                                      AlternationCount="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Tr Common_ColRequest}" Binding="{Binding RequestId}" Width="*"/>
                                    <DataGridTextColumn Header="{loc:Tr Common_ColBuild}" Binding="{Binding BuildId}" Width="*"/>
                                    <DataGridTextColumn Header="{loc:Tr Common_ColDate}" Binding="{Binding RequestedAt, StringFormat=yyyy-MM-dd}" Width="100"/>
                                    <DataGridTemplateColumn Header="{loc:Tr Common_ColStatus}" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource StatusBadge}">
                                                    <TextBlock Style="{StaticResource StatusBadgeText}">
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource LocalizedStatus}">
                                                                <Binding Path="Status"/>
                                                                <Binding Path="Language" Source="{x:Static loc:Loc.Instance}"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Style="{StaticResource EmptyStateCard}"
                                    Visibility="{Binding Items.Count, ElementName=SellerRequestsGrid, Converter={StaticResource CountToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr Seller_EmptyRequestsTitle}" Style="{StaticResource EmptyStateTitle}"/>
                                    <TextBlock Text="{loc:Tr Seller_EmptyRequestsText}"
                                               Style="{StaticResource EmptyStateText}"/>
                                </StackPanel>
                            </Border>
                            </Grid>

                            <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                                <Button x:Name="SellerAcceptButton" Content="{loc:Tr Seller_Accept}" Command="{Binding AcceptCommand}"
                                        Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/>
                                <Button x:Name="SellerInProgressButton" Content="{loc:Tr Seller_InProgress}" Command="{Binding StartProgressCommand}"
                                        Style="{StaticResource InfoButton}" Margin="0,0,8,8"/>
                                <Button Content="{loc:Tr Seller_Complete}" Command="{Binding CompleteCommand}"
                                        Style="{StaticResource SuccessButton}" Margin="0,0,8,8"/>
                                <Button Content="{loc:Tr Seller_Cancel}" Command="{Binding CancelCommand}"
                                        Style="{StaticResource DangerButton}" Margin="0,0,8,8"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- Snapshot -->
                    <Border Grid.Column="2" Style="{StaticResource DashboardCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{loc:Tr Seller_SnapshotTitle}" Style="{StaticResource SectionTitle}"/>
                            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="2">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBox Text="{Binding SelectedRequestPayload, Mode=OneWay}"
                                             IsReadOnly="True" TextWrapping="Wrap"
                                             BorderThickness="0" Background="Transparent"
                                             FontFamily="{StaticResource AppFontFamily}"
                                             Padding="10"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- QC test section -->
                <Grid Visibility="{Binding IsChecked, ElementName=NavQc, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <Border Style="{StaticResource DashboardCard}" Margin="0,0,0,14">
                        <DockPanel>
                            <Button x:Name="QcStartButton" DockPanel.Dock="Right" Content="{loc:Tr QcTest_Start}"
                                    Command="{Binding StartQcTestCommand}"
                                    Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="{loc:Tr QcTest_Title}" Style="{StaticResource SectionTitle}" Margin="0"/>
                                <TextBlock Text="{loc:Tr QcTest_StartHint}" Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Summary card -->
                    <Border Grid.Row="1" Style="{StaticResource DashboardCard}" Margin="0,0,0,14"
                            AutomationProperties.AutomationId="SellerQcSummaryPanel"
                            Visibility="{Binding QcSummaryVisibility}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Border DockPanel.Dock="Right" Style="{StaticResource BadgeChrome}"
                                        Background="{Binding QcSession.Status, Converter={StaticResource StatusToBrushConverter}}">
                                    <TextBlock Style="{StaticResource StatusBadgeText}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource LocalizedStatus}">
                                                <Binding Path="QcSession.Status"/>
                                                <Binding Path="Language" Source="{x:Static loc:Loc.Instance}"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Border>
                                <TextBlock AutomationProperties.AutomationId="SellerQcSummaryTitle"
                                           Text="{loc:Tr QcTest_Summary}" Style="{StaticResource SectionTitle}"
                                           Margin="0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <UniformGrid Rows="1" Columns="4" Margin="0,0,0,10">
                                <Border Style="{StaticResource KpiCard}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Tr QcTest_Tested}" Style="{StaticResource MutedText}"/>
                                        <TextBlock AutomationProperties.AutomationId="SellerQcTestedCount"
                                                   FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0}/{1}">
                                                    <Binding Path="QcSession.TestedKeys"/>
                                                    <Binding Path="QcSession.TotalKeys"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource KpiCard}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Tr QcTest_Passed}" Style="{StaticResource MutedText}"/>
                                        <TextBlock Text="{Binding QcSession.PassedKeys}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource KpiCard}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Tr QcTest_Warning}" Style="{StaticResource MutedText}"/>
                                        <TextBlock Text="{Binding QcSession.WarningKeys}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource KpiCard}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Tr QcTest_Failed}" Style="{StaticResource MutedText}"/>
                                        <TextBlock Text="{Binding QcSession.FailedKeys}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <UniformGrid Rows="1" Columns="4">
                                <Border Style="{StaticResource KpiCard}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Tr QcTest_AvgLatency}" Style="{StaticResource MutedText}"/>
                                        <TextBlock Text="{Binding QcSession.AverageLatencyMs, StringFormat=N2, TargetNullValue=-}" FontSize="18" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource KpiCard}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Tr QcTest_MaxLatency}" Style="{StaticResource MutedText}"/>
                                        <TextBlock Text="{Binding QcSession.MaxLatencyMs, StringFormat=N2, TargetNullValue=-}" FontSize="18" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource KpiCard}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Tr QcTest_AvgNoise}" Style="{StaticResource MutedText}"/>
                                        <TextBlock Text="{Binding QcSession.AverageNoiseDb, StringFormat=N2, TargetNullValue=-}" FontSize="18" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource KpiCard}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Tr QcTest_MaxNoise}" Style="{StaticResource MutedText}"/>
                                        <TextBlock Text="{Binding QcSession.MaxNoiseDb, StringFormat=N2, TargetNullValue=-}" FontSize="18" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Per-key results -->
                    <Border Grid.Row="2" Style="{StaticResource DashboardCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{loc:Tr QcTest_PerKey}" Style="{StaticResource SectionTitle}"/>
                            <Grid Grid.Row="1">
                                <DataGrid x:Name="QcKeyResultsGrid" ItemsSource="{Binding KeyResults}" AlternationCount="2">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{loc:Tr QcTest_ColKey}" Binding="{Binding KeyCode}" Width="*"/>
                                        <DataGridCheckBoxColumn Header="{loc:Tr QcTest_ColPress}" Binding="{Binding PressSignalDetected}" Width="70" IsReadOnly="True"/>
                                        <DataGridCheckBoxColumn Header="{loc:Tr QcTest_ColRelease}" Binding="{Binding ReleaseSignalDetected}" Width="80" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="{loc:Tr QcTest_ColPressEvents}" Binding="{Binding PressEventCount}" Width="100"/>
                                        <DataGridTextColumn Header="{loc:Tr QcTest_ColBounce}" Binding="{Binding BounceCount}" Width="80"/>
                                        <DataGridTextColumn Header="{loc:Tr QcTest_ColLatency}" Binding="{Binding LatencyMs, StringFormat=N2}" Width="100"/>
                                        <DataGridCheckBoxColumn Header="{loc:Tr QcTest_ColStuck}" Binding="{Binding IsStuck}" Width="60" IsReadOnly="True"/>
                                        <DataGridTemplateColumn Header="{loc:Tr QcTest_ColResult}" Width="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource BadgeChrome}"
                                                            Background="{Binding Result, Converter={StaticResource StatusToBrushConverter}}">
                                                        <TextBlock Style="{StaticResource StatusBadgeText}">
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{StaticResource LocalizedStatus}">
                                                                    <Binding Path="Result"/>
                                                                    <Binding Path="Language" Source="{x:Static loc:Loc.Instance}"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="{loc:Tr QcTest_ColFailureType}" Binding="{Binding FailureType}" Width="120"/>
                                        <DataGridTextColumn Header="{loc:Tr QcTest_ColReason}" Binding="{Binding FailureReason}" Width="2*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Style="{StaticResource EmptyStateCard}"
                                        Visibility="{Binding Items.Count, ElementName=QcKeyResultsGrid, Converter={StaticResource CountToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Tr QcTest_NoData}" Style="{StaticResource EmptyStateTitle}"/>
                                        <TextBlock Text="{loc:Tr QcTest_StartHint}" Style="{StaticResource EmptyStateText}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Analytics section -->
                <Grid Visibility="{Binding IsChecked, ElementName=NavAnalytics, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- KPI -->
                    <UniformGrid Rows="1" Columns="5" Margin="0,0,0,14">
                        <Border Style="{StaticResource KpiCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr Seller_KpiRevenue}" Style="{StaticResource MutedText}"/>
                                <TextBlock Text="{Binding TotalRevenue, StringFormat=N2}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr Seller_KpiProducts}" Style="{StaticResource MutedText}"/>
                                <TextBlock Text="{Binding ProductsMade}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr Seller_KpiCustomers}" Style="{StaticResource MutedText}"/>
                                <TextBlock Text="{Binding TotalCustomers}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr Seller_KpiInProgress}" Style="{StaticResource MutedText}"/>
                                <TextBlock Text="{Binding InProgressOrders}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr Seller_KpiAvgCompletion}" Style="{StaticResource MutedText}"/>
                                <TextBlock Text="{Binding AvgCompletionText}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="360"/>
                        </Grid.ColumnDefinitions>

                        <!-- Revenue + orders -->
                        <Border Style="{StaticResource DashboardCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,8">
                                    <ComboBox DockPanel.Dock="Right" Width="130"
                                              ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}"/>
                                    <TextBlock Text="{loc:Tr Seller_RevenueOrders}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                                </DockPanel>
                                <lvc:CartesianChart Grid.Row="1" MinHeight="260"
                                                    Series="{Binding RevenueSeries}"
                                                    XAxes="{Binding RevenueXAxes}"
                                                    YAxes="{Binding RevenueYAxes}"
                                                    LegendPosition="Bottom"
                                                    TooltipPosition="Top"
                                                    ZoomMode="None"/>
                            </Grid>
                        </Border>

                        <!-- Status donut + top kits -->
                        <Border Grid.Column="2" Style="{StaticResource DashboardCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="240"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{loc:Tr Seller_StatusRatio}" Style="{StaticResource SectionTitle}"/>
                                <lvc:PieChart Grid.Row="1"
                                              Series="{Binding StatusSeries}"
                                              LegendPosition="Bottom"/>
                                <TextBlock Grid.Row="2" Text="{loc:Tr Seller_TopKit}" Style="{StaticResource SectionTitle}" Margin="0,12,0,8"/>
                                <Grid Grid.Row="3">
                                    <ItemsControl x:Name="TopKitsList" ItemsSource="{Binding TopKits}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,0,0,6">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Revenue, StringFormat=N2}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Orders, StringFormat=' x{0}'}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding KitName}" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Style="{StaticResource EmptyStateCard}"
                                            Visibility="{Binding Items.Count, ElementName=TopKitsList, Converter={StaticResource CountToVisibility}}">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Tr Seller_EmptyKitsTitle}" Style="{StaticResource EmptyStateTitle}"/>
                                            <TextBlock Text="{loc:Tr Seller_EmptyKitsText}"
                                                       Style="{StaticResource EmptyStateText}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Chat section -->
                <Border Visibility="{Binding IsChecked, ElementName=NavChat, Converter={StaticResource BoolToVis}}"
                        Background="{StaticResource AppBackdropBrush}">
                    <views:ChatView DataContext="{Binding Chat}"/>
                </Border>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="2" Margin="0,12,0,0" Style="{StaticResource StatusBarCard}">
                <DockPanel>
                    <Border DockPanel.Dock="Right"
                            Style="{StaticResource BadgeChrome}"
                            Background="{StaticResource AccentBrush}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:Tr Common_Processing}" Style="{StaticResource StatusBadgeText}"/>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="4" Background="{StaticResource AccentBrush}" CornerRadius="2" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
