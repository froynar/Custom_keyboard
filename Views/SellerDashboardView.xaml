<UserControl x:Class="Custom_keyboard.Views.SellerDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,20">
            <Button DockPanel.Dock="Right"
                    Content="Dang xuat"
                    Command="{Binding LogoutCommand}"
                    Padding="14,8"
                    Background="#EEF2F6"
                    BorderBrush="#DDE2E8"/>
            <StackPanel>
                <TextBlock Text="{Binding Title}"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#20242B"/>
                <TextBlock Text="{Binding Subtitle}"
                           Margin="0,4,0,0"
                           Foreground="#687381"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Padding="18"
                    Background="White"
                    BorderBrush="#DDE2E8"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Tai khoan"
                               FontWeight="SemiBold"
                               FontSize="16"
                               Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding CurrentUser.Username}" FontSize="15"/>
                    <TextBlock Text="{Binding CurrentUser.Email}" Foreground="#687381" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding CurrentUser.Role}" Foreground="#687381" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Padding="18"
                    Background="White"
                    BorderBrush="#DDE2E8"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Seller workflow"
                               FontWeight="SemiBold"
                               FontSize="16"
                               Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding Tasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Margin="0,0,0,10"
                                           FontSize="14"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
